  <SolidColorBrush x:Key="TileAccent" Color="#E2BD45"/>
  <Style x:Key="TaskTile" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Margin" Value="0,0,10,10"/>
    <Setter Property="Height" Value="100"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>

            <Border x:Name="Glow" CornerRadius="11.5" Margin="-1.5" Background="#D4AF37" Opacity="0" Visibility="Collapsed">
              <Border.Effect><DropShadowEffect Color="#E8C04A" BlurRadius="24" ShadowDepth="0" Opacity="1"/></Border.Effect>
            </Border>

            <Border x:Name="Bd" CornerRadius="10" BorderThickness="1" BorderBrush="#242427">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#1C1C1F" Offset="0"/>
                  <GradientStop Color="#151517" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
            </Border>

            <Grid x:Name="On" Opacity="0" IsHitTestVisible="False">
              <Border CornerRadius="10" Background="#141416"/>
              <Border CornerRadius="10" Background="{DynamicResource TileAccent}" Opacity="0.2">
                <Border.OpacityMask>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF000000" Offset="0"/>
                    <GradientStop Color="#22000000" Offset="1"/>
                  </LinearGradientBrush>
                </Border.OpacityMask>
              </Border>
              <Border CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource TileAccent}" Opacity="0.55"/>
              <Border Height="2" VerticalAlignment="Top" Margin="12,0.5,12,0" CornerRadius="1" Background="{DynamicResource TileAccent}">
                <Border.OpacityMask>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#FF000000" Offset="0.3"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                  </LinearGradientBrush>
                </Border.OpacityMask>
              </Border>
              <Grid Margin="14,12,9,10">
                <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="20" Height="20" Stroke="{DynamicResource TileAccent}"
                      Stretch="Uniform" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Ellipse x:Name="OnDot" Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0" Fill="{DynamicResource TileAccent}">
                  <Ellipse.Effect><DropShadowEffect Color="White" BlurRadius="8" ShadowDepth="0" Opacity="0.35"/></Ellipse.Effect>
                </Ellipse>
              </Grid>
            </Grid>
            <Grid Margin="14,12,9,10">
              <Path x:Name="Ico" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="20" Height="20" Stroke="#6F6B61"
                    Stretch="Uniform" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    HorizontalAlignment="Left" VerticalAlignment="Top"/>
              <Ellipse x:Name="Dot" Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0" Fill="#2F2F32"/>
              <StackPanel x:Name="Texts" VerticalAlignment="Bottom" Margin="0,0,4,0">
                <TextBlock x:Name="Name" Text="{TemplateBinding Content}" FontSize="13" TextWrapping="Wrap" TextTrimming="None" LineHeight="16">
                  <TextBlock.Foreground><SolidColorBrush x:Name="NameBrush" Color="#A8A292"/></TextBlock.Foreground>
                </TextBlock>

                <TextBlock x:Name="Status" Text="" FontSize="11.5" Foreground="{StaticResource Text3}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Button x:Name="MoreBtn" Visibility="Collapsed" Focusable="False" Cursor="Hand" ToolTip="Options" Width="28" Height="22"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-3,0">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="Transparent" CornerRadius="6">
                      <TextBlock x:Name="T" Text="&#x2022;&#x2022;&#x2022;" FontSize="10" Foreground="{StaticResource Text3}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="B" Property="Background" Value="{StaticResource Raised2}"/>
                        <Setter TargetName="T" Property="Foreground" Value="{StaticResource Text}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Uid" Value="1">
              <Setter TargetName="MoreBtn" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Dot" Property="Opacity" Value="0"/>
              <Setter TargetName="OnDot" Property="Opacity" Value="0"/>
            </Trigger>

            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource TileAccent}"/>
              <Setter TargetName="Ico" Property="Visibility" Value="Hidden"/>
              <Setter TargetName="Dot" Property="Visibility" Value="Hidden"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22"/>
                    <ColorAnimation Storyboard.TargetName="NameBrush" Storyboard.TargetProperty="Color" To="#F0EAD8" Duration="0:0:0.22"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                    <ColorAnimation Storyboard.TargetName="NameBrush" Storyboard.TargetProperty="Color" To="#A8A292" Duration="0:0:0.22"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.035" Duration="0:0:0.12"/>
                    <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.035" Duration="0:0:0.12"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                    <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger SourceName="Status" Property="Text" Value=""><Setter TargetName="Status" Property="Visibility" Value="Collapsed"/></Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Margin" Value="0,1,0,-1"/>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.35"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TaskGroup" TargetType="HeaderedContentControl">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Margin" Value="0,0,12,12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="HeaderedContentControl">
          <Border CornerRadius="12" Background="#131315" BorderBrush="#1F1F22" BorderThickness="1" ClipToBounds="True">
            <Grid>
              <Border Height="70" VerticalAlignment="Top" Background="{DynamicResource TileAccent}" Opacity="0.08" CornerRadius="12,12,0,0">
                <Border.OpacityMask>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF000000" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                  </LinearGradientBrush>
                </Border.OpacityMask>
              </Border>
              <DockPanel Margin="14,11,4,4">
                <Grid DockPanel.Dock="Top" Margin="2,0,12,9">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="4" Height="15" CornerRadius="2" Background="{DynamicResource TileAccent}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource Deco}" FontSize="16" Foreground="{StaticResource Text}"
                               Margin="9,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock x:Name="Count" Text="" FontSize="12" Foreground="{StaticResource Text3}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <ContentPresenter/>
              </DockPanel>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

