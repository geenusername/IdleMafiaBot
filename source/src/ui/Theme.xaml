  <Style x:Key="StatTile" TargetType="ContentControl">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Margin" Value="0,0,10,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid>
            <Border x:Name="Bd" CornerRadius="10" Background="#17171A" BorderBrush="#242427" BorderThickness="1"/>
            <Border CornerRadius="10" Background="{DynamicResource TileAccent}" Opacity="0.1">
              <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#FF000000" Offset="0"/>
                  <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
              </Border.OpacityMask>
            </Border>
            <Border Height="2" VerticalAlignment="Top" Margin="12,0.5,12,0" CornerRadius="1" Background="{DynamicResource TileAccent}">
              <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#00000000" Offset="0"/>
                  <GradientStop Color="#FF000000" Offset="0.3"/>
                  <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
              </Border.OpacityMask>
            </Border>
            <Grid Margin="15,10,12,10">
              <ContentPresenter VerticalAlignment="Center"/>
              <Grid Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse Fill="{DynamicResource TileAccent}" Opacity="0.15"/>
                <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="16" Height="16" Stroke="{DynamicResource TileAccent}"
                      Stretch="Uniform" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Grid>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Raised}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Line}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ActionTile" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Margin" Value="0,0,10,10"/>
    <Setter Property="Height" Value="100"/>
    <Setter Property="Foreground" Value="#E0DACA"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
            <Border CornerRadius="10" BorderThickness="1" BorderBrush="#242427">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#1C1C1F" Offset="0"/>
                  <GradientStop Color="#151517" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Grid x:Name="Prime" Visibility="Collapsed" IsHitTestVisible="False">
              <Border CornerRadius="10" Background="{DynamicResource TileAccent}" Opacity="0.2">
                <Border.OpacityMask>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF000000" Offset="0"/>
                    <GradientStop Color="#22000000" Offset="1"/>
                  </LinearGradientBrush>
                </Border.OpacityMask>
              </Border>
              <Border CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource TileAccent}" Opacity="0.55"/>
            </Grid>
            <Grid x:Name="Hi" Opacity="0" IsHitTestVisible="False">
              <Border CornerRadius="10" Background="{DynamicResource TileAccent}" Opacity="0.12"/>
              <Border CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource TileAccent}" Opacity="0.45"/>
            </Grid>
            <Grid Margin="14,12,9,10">
              <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="20" Height="20" Stroke="{DynamicResource TileAccent}"
                    Stretch="Uniform" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    HorizontalAlignment="Left" VerticalAlignment="Top"/>
              <ContentPresenter VerticalAlignment="Bottom" Margin="0,0,4,0"/>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Uid" Value="1"><Setter TargetName="Prime" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hi" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                    <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.035" Duration="0:0:0.12"/>
                    <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.035" Duration="0:0:0.12"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hi" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                    <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                    <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Margin" Value="0,1,0,-1"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

