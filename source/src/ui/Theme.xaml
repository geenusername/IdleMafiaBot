<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="Bg" Color="#101011"/>
  <SolidColorBrush x:Key="Rail" Color="#0A0A0B"/>
  <SolidColorBrush x:Key="Panel" Color="#1A1A1C"/>
  <SolidColorBrush x:Key="Panel2" Color="#212123"/>
  <SolidColorBrush x:Key="Raised" Color="#262628"/>
  <SolidColorBrush x:Key="Raised2" Color="#2F2F32"/>
  <SolidColorBrush x:Key="Field" Color="#0D0D0E"/>
  <SolidColorBrush x:Key="Line" Color="#2C2C2F"/>
  <SolidColorBrush x:Key="LineSoft" Color="#222225"/>
  <SolidColorBrush x:Key="Text" Color="#E8E2D0"/>
  <SolidColorBrush x:Key="Text2" Color="#A8A292"/>
  <SolidColorBrush x:Key="Text3" Color="#6F6B61"/>
  <SolidColorBrush x:Key="Gold" Color="#D4AF37"/>
  <SolidColorBrush x:Key="GoldDark" Color="#947A26"/>
  <SolidColorBrush x:Key="GoldSoft" Color="#26D4AF37"/>
  <SolidColorBrush x:Key="OnGold" Color="#141414"/>
  <SolidColorBrush x:Key="Red" Color="#C84B3F"/>
  <SolidColorBrush x:Key="Green" Color="#7EBE5A"/>
  <SolidColorBrush x:Key="Energy" Color="#E08C32"/>
  <SolidColorBrush x:Key="Stamina" Color="#5B8FB9"/>
  <SolidColorBrush x:Key="Health" Color="#BA4A3E"/>
  <SolidColorBrush x:Key="Xp" Color="#8B6ABB"/>
  <SolidColorBrush x:Key="Track" Color="#0D0D0E"/>

  <FontFamily x:Key="Serif">Palatino Linotype, Georgia</FontFamily>
  <FontFamily x:Key="Sans">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>

  <FontFamily x:Key="Deco">Palatino Linotype, Georgia</FontFamily>

  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Serif}"/>
    <Setter Property="Foreground" Value="{StaticResource Gold}"/>
    <Setter Property="FontSize" Value="30"/>
  </Style>
  <Style x:Key="CardTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Display}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
  </Style>
  <Style x:Key="Label" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource Text3}"/>
  </Style>
  <Style x:Key="Hint" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource Text2}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="TextTrimming" Value="None"/>
  </Style>
  <Style x:Key="Big" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Display}"/>
    <Setter Property="FontWeight" Value="Black"/>
    <Setter Property="FontSize" Value="24"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
  </Style>

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Panel}"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="BorderBrush" Value="{StaticResource LineSoft}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="20,18"/>
    <Setter Property="Margin" Value="0,0,0,14"/>
  </Style>

  <Style x:Key="Btn" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="Background" Value="{StaticResource Raised}"/>
    <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="16,10"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"
                  BorderBrush="{StaticResource Line}" BorderThickness="1" RenderTransformOrigin="0.5,0.5">

            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Raised2}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Foreground" Value="{StaticResource OnGold}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">

            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.88"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Background" Value="{StaticResource Gold}"/>
  </Style>

  <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Foreground" Value="{StaticResource Text2}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Raised}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="WinBtn" TargetType="Button">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Foreground" Value="{StaticResource Text2}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Raised}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource WinBtn}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Red}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ContentPresenter VerticalAlignment="Center" Margin="0,0,18,0"/>

            <Border x:Name="Track" Grid.Column="1" Width="40" Height="22" CornerRadius="11" Background="{StaticResource Raised}"
                    BorderBrush="{StaticResource Raised2}" BorderThickness="1" VerticalAlignment="Center">
              <Ellipse x:Name="Knob" Width="14" Height="14" Fill="{StaticResource Text3}" HorizontalAlignment="Left" Margin="3,0,0,0"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="#4D4220"/>
              <Setter TargetName="Track" Property="BorderBrush" Value="#7A6526"/>
              <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Gold}"/>
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
              <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.88"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="RarityChip" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Margin" Value="0,0,8,8"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border x:Name="Bd" CornerRadius="16" Padding="10,6,14,6" Background="{StaticResource Field}" BorderThickness="1.5"
                  BorderBrush="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
            <StackPanel Orientation="Horizontal">
              <Grid Width="16" Height="16" VerticalAlignment="Center">
                <Ellipse x:Name="Dot" StrokeThickness="1.5"
                         Fill="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                         Stroke="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                <Path x:Name="Tick" Data="M4.2,8.3 L7,11 L12,5.4" Stroke="{StaticResource OnGold}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
              </Grid>
              <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="False">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Line}"/>
              <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
              <Setter TargetName="Dot" Property="Fill" Value="Transparent"/>
              <Setter TargetName="Tick" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Raised}"/></Trigger>

            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.3"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SegmentBar" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Field}"/>
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Padding" Value="2"/>
    <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>
  <Style x:Key="Segment" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{StaticResource Text2}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bd" CornerRadius="7" Padding="12,5" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Text}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Raised2}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="#3A3A3E"/>
              <Setter Property="Foreground" Value="{StaticResource Gold}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="RailItem" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{StaticResource Text2}"/>
    <Setter Property="GroupName" Value="rail"/>
    <Setter Property="Margin" Value="0,0,0,2"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Width="176" Height="40" Background="Transparent">
            <Border x:Name="Box" Margin="10,0" CornerRadius="8" Background="Transparent"/>
            <Border x:Name="Pill" Width="3" Height="18" CornerRadius="0,3,3,0" Background="{StaticResource Gold}"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Hidden"/>
            <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
              <ContentPresenter VerticalAlignment="Center"/>
              <TextBlock x:Name="Name" Text="{TemplateBinding Tag}" FontSize="14" Margin="13,0,0,1"
                         Foreground="{StaticResource Text2}" VerticalAlignment="Center"/>
            </StackPanel>
            <Border x:Name="Badge" MinWidth="20" Height="18" CornerRadius="9" Background="{StaticResource Red}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0" Padding="6,0">
              <TextBlock Text="{TemplateBinding Uid}" FontSize="10.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Uid" Value="">
              <Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsChecked" Value="False"/></MultiTrigger.Conditions>
              <Setter TargetName="Box" Property="Background" Value="{StaticResource Panel}"/>
              <Setter Property="Foreground" Value="{StaticResource Text}"/>
              <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Text}"/>
            </MultiTrigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource Panel2}"/>
              <Setter Property="Foreground" Value="{StaticResource Gold}"/>
              <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Text}"/>
              <Setter TargetName="Name" Property="FontWeight" Value="SemiBold"/>
              <Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TopTab" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="GroupName" Value="rail"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Margin" Value="0,0,26,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <StackPanel Margin="0,6,0,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="Name" Text="{TemplateBinding Tag}" FontFamily="{StaticResource Deco}" FontSize="19" Foreground="{StaticResource Text3}"/>
                <Border x:Name="Badge" MinWidth="18" Height="18" CornerRadius="9" Background="{StaticResource Red}" Margin="7,2,0,0" Padding="5,0" VerticalAlignment="Top">
                  <TextBlock Text="{TemplateBinding Uid}" FontSize="10.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </StackPanel>
              <Border x:Name="Line" Height="2" CornerRadius="1" Margin="0,5,0,0" HorizontalAlignment="Left" Width="0" Background="{StaticResource Gold}"/>
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Uid" Value=""><Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Name" Property="Foreground" Value="{StaticResource Text2}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Text}"/>
              <Trigger.EnterActions>
                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Line" Storyboard.TargetProperty="Width" To="28" Duration="0:0:0.2"/></Storyboard></BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Line" Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.15"/></Storyboard></BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Icon" TargetType="Path">
    <Setter Property="Width" Value="22"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="StrokeThickness" Value="1.9"/>
    <Setter Property="StrokeLineJoin" Value="Round"/>
    <Setter Property="StrokeStartLineCap" Value="Round"/>
    <Setter Property="StrokeEndLineCap" Value="Round"/>
    <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
  </Style>

  <Style x:Key="ComboItem" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Padding="12,8" CornerRadius="7" Background="Transparent" Margin="2,1">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Raised2}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource Gold}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Bd" Background="{StaticResource Field}" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1.5">
                    <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" Data="M0,0 L5,5 L10,0"
                          Stroke="{StaticResource Text2}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldDark}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Gold}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter IsHitTestVisible="False" Margin="14,0,36,0" VerticalAlignment="Center"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                   Focusable="False" PopupAnimation="Fade">
              <Border Background="{StaticResource Raised}" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="340" Margin="0,6,0,0" Padding="2,4">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="StepBtn" TargetType="RepeatButton">
    <Setter Property="Width" Value="34"/>
    <Setter Property="Foreground" Value="{StaticResource Text2}"/>
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Delay" Value="350"/>
    <Setter Property="Interval" Value="60"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Raised2}"/>
              <Setter Property="Foreground" Value="{StaticResource Gold}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ControlTemplate x:Key="ThumbTemplate" TargetType="Thumb">
    <Border CornerRadius="4" Background="{StaticResource Raised2}" Margin="2"/>
  </ControlTemplate>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10"/>
    <Setter Property="MinWidth" Value="10"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.Thumb><Thumb Template="{StaticResource ThumbTemplate}"/></Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track">
                <Track.Thumb><Thumb Template="{StaticResource ThumbTemplate}"/></Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Geometry x:Key="IcoHome">M3,11 L12,3.5 L21,11 M5.5,9.5 L5.5,20.5 L18.5,20.5 L18.5,9.5 M10,20.5 L10,14.5 L14,14.5 L14,20.5</Geometry>
  <Geometry x:Key="IcoJobs">M3.5,8 L20.5,8 L20.5,19.5 L3.5,19.5 Z M9,8 L9,5.5 L15,5.5 L15,8 M3.5,13 L20.5,13</Geometry>
  <Geometry x:Key="IcoHeist">M4,4 L20,4 L20,20 L4,20 Z M8.5,12 A3.5,3.5 0 1 1 15.5,12 A3.5,3.5 0 1 1 8.5,12 M12,12 L14,10 M7,20 L7,21.5 M17,20 L17,21.5</Geometry>
  <Geometry x:Key="IcoSwords">M5,5 L15,15 M13,17 L17,13 M15,15 L19,19 M19,5 L9,15 M7,13 L11,17 M9,15 L5,19</Geometry>
  <Geometry x:Key="IcoCrown">M3.5,17.5 L5,7.5 L9.5,11.5 L12,5.5 L14.5,11.5 L19,7.5 L20.5,17.5 Z M5,20.5 L19,20.5</Geometry>
  <Geometry x:Key="IcoBank">M3,9.5 L12,4 L21,9.5 Z M6,11.5 L6,17 M10,11.5 L10,17 M14,11.5 L14,17 M18,11.5 L18,17 M3.5,20 L20.5,20</Geometry>
