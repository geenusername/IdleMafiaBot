  <Style x:Key="Section" TargetType="HeaderedContentControl">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Margin" Value="0,0,0,14"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="HeaderedContentControl">
          <Border Background="{StaticResource Panel}" CornerRadius="16" BorderBrush="{StaticResource LineSoft}" BorderThickness="1" Padding="20,16,20,18">
            <StackPanel>
              <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource GoldSoft}" VerticalAlignment="Center">
                  <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stroke="{StaticResource Gold}" Width="17" Height="17"
                        Stretch="Uniform" StrokeThickness="1.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource CardTitle}"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
              </Grid>
              <ContentPresenter/>
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource Raised}"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="420" FontSize="13" LineHeight="19"/>
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>

