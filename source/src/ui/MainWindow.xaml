<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Idle Mafia Bot" Width="1260" Height="840" MinWidth="1060" MinHeight="700"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Sans}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid x:Name="Root">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="84"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Background="{StaticResource Rail}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <Grid Height="72">
            <Path Data="{StaticResource IcoFedora}" Fill="{StaticResource Gold}" Width="42" Height="42" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <Border Height="2" Width="32" CornerRadius="1" Background="{StaticResource Raised}" Margin="0,0,0,16"/>
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" Height="60" ToolTip="Green when the bot is running">
          <Ellipse x:Name="RunGlow" Width="22" Height="22" Fill="{StaticResource Text3}" Opacity="0.18"/>
          <Ellipse x:Name="RunLamp" Width="10" Height="10" Fill="{StaticResource Text3}"/>
        </Grid>

        <Viewbox StretchDirection="DownOnly" VerticalAlignment="Top" HorizontalAlignment="Center">
        <StackPanel>
          <RadioButton x:Name="RailOverview" Style="{StaticResource RailItem}" Tag="Home" IsChecked="True" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Style="{StaticResource Icon}" Data="{StaticResource IcoHome}"/>
          </RadioButton>
          <RadioButton x:Name="RailJobs" Style="{StaticResource RailItem}" Tag="Energy">
            <Path Style="{StaticResource Icon}" Data="{StaticResource IcoBolt}"/>
          </RadioButton>
          <RadioButton x:Name="RailCombat" Style="{StaticResource RailItem}" Tag="Stamina">
            <Path Style="{StaticResource Icon}" Data="{StaticResource IcoSwords}"/>
          </RadioButton>
          <RadioButton x:Name="RailCrew" Style="{StaticResource RailItem}" Tag="Crew">
            <Path Style="{StaticResource Icon}" Data="{StaticResource IcoCrew}"/>
          </RadioButton>
          <RadioButton x:Name="RailGear" Style="{StaticResource RailItem}" Tag="Gear">
            <Path Style="{StaticResource Icon}" Data="{StaticResource IcoGear}"/>
          </RadioButton>
          <RadioButton x:Name="RailMoney" Style="{StaticResource RailItem}" Tag="Cash">
            <Path Style="{StaticResource Icon}" Data="{StaticResource IcoBank}"/>
          </RadioButton>
          <RadioButton x:Name="RailRewards" Style="{StaticResource RailItem}" Tag="Rewards">
            <Path Style="{StaticResource Icon}" Data="{StaticResource IcoGift}"/>
          </RadioButton>
          <RadioButton x:Name="RailSettings" Style="{StaticResource RailItem}" Tag="Settings">
            <Path Style="{StaticResource Icon}" Data="{StaticResource IcoSliders}"/>
          </RadioButton>
        </StackPanel>
        </Viewbox>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="84"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Margin="30,0,10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,4,0,0">
          <TextBlock x:Name="PageTitle" Style="{StaticResource PageTitle}" Text="HOME"/>
          <TextBlock x:Name="PageSub" Style="{StaticResource Hint}" Text="" Margin="1,0,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,10,0,0">

          <Button x:Name="BtnDiscordTop" Style="{StaticResource PrimaryBtn}" Background="#5865F2" Padding="14,10" Margin="0,4,10,0"
                  VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Questions, problems or ideas? Ask in the Discord">
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource IcoDiscord}" Fill="White" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
              <TextBlock Text="Discord" Margin="8,0,0,0" FontWeight="Bold" FontSize="13.5" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Border x:Name="StatePill" CornerRadius="17" Background="{StaticResource Panel}" Padding="13,8" Margin="0,4,10,0"
                  VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="StateDot" Width="9" Height="9" Fill="{StaticResource Text3}" VerticalAlignment="Center"/>
              <TextBlock x:Name="StateText" Text="Stopped" Margin="9,0,0,0" FontWeight="SemiBold" FontSize="13"
                         Foreground="{StaticResource Text2}" MaxWidth="330"/>
            </StackPanel>
          </Border>
          <Button x:Name="BtnStart" Style="{StaticResource PrimaryBtn}" Padding="18,11" Margin="0,4,16,0" MinWidth="132"
                  VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel Orientation="Horizontal">
              <Path x:Name="BtnStartIcon" Data="{StaticResource IcoPlay}" Fill="{StaticResource OnGold}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
              <TextBlock x:Name="BtnStartText" Text="Start" Margin="9,0,0,0" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource OnGold}"/>
              <Border CornerRadius="5" Background="#22000000" Padding="5,1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="F6" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OnGold}"/>
              </Border>
            </StackPanel>
          </Button>
          <Button x:Name="BtnMin" Style="{StaticResource WinBtn}" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize">
            <Path Data="M0,0 L10,0" Stroke="{StaticResource Text2}" StrokeThickness="1.2"/>
          </Button>
          <Button x:Name="BtnMax" Style="{StaticResource WinBtn}" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize">
            <Path Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z" Stroke="{StaticResource Text2}" StrokeThickness="1.2"/>
          </Button>
          <Button x:Name="BtnClose" Style="{StaticResource CloseBtn}" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close">
            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource Text}" StrokeThickness="1.2"/>
          </Button>
        </StackPanel>
      </Grid>

      <Border x:Name="NowStrip" Grid.Row="1" Margin="30,0,30,14" CornerRadius="12" Background="{StaticResource Panel}"
              BorderBrush="{StaticResource LineSoft}" BorderThickness="1" Padding="14,10" Visibility="Collapsed">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Grid Width="16" Height="16" VerticalAlignment="Center">
              <Ellipse x:Name="NowGlow" Width="16" Height="16" Fill="{StaticResource Gold}" Opacity="0.25"/>
              <Ellipse Width="8" Height="8" Fill="{StaticResource Gold}"/>
            </Grid>
            <TextBlock x:Name="NowText" Margin="10,0,0,0" FontSize="13.5" Foreground="{StaticResource Text2}" VerticalAlignment="Center"/>
          </StackPanel>

          <TextBlock x:Name="StuckText" Margin="26,6,0,0" FontSize="13" Foreground="{StaticResource Red}" TextWrapping="Wrap" Visibility="Collapsed"/>
          <TextBlock x:Name="FullBarsText" Margin="26,6,0,0" FontSize="12.5" Foreground="{StaticResource Text3}" TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>
      </Border>

      <Border x:Name="OcrBanner" Grid.Row="1" Margin="30,0,30,14" CornerRadius="12" Background="#2B1917" BorderBrush="#66C84B3F"
              BorderThickness="1" Padding="16,13" Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Path Style="{StaticResource Icon}" Data="{StaticResource IcoWarn}" Stroke="{StaticResource Red}" VerticalAlignment="Top" Margin="0,0,14,0"/>
          <StackPanel Grid.Column="1">
            <TextBlock x:Name="OcrTitle" Text="The bot can't read the game yet" FontWeight="Bold" FontSize="15"/>
            <TextBox x:Name="OcrText" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0"
                     Margin="-2,4,0,0" FontSize="13" Foreground="{StaticResource Text2}" CaretBrush="{StaticResource Text}"
                     SelectionBrush="{StaticResource Gold}"/>
          </StackPanel>
          <Button x:Name="BtnOcrSettings" Grid.Column="2" Style="{StaticResource Btn}" VerticalAlignment="Top" Margin="16,0,0,0">
            <TextBlock Text="Open language settings" FontWeight="SemiBold"/>
          </Button>
        </Grid>
      </Border>

      <Grid Grid.Row="2">

        <ScrollViewer x:Name="PageOverview" VerticalScrollBarVisibility="Auto">
          <Grid x:Name="HomeGrid" Margin="30,0,30,16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="CheckCard" Grid.Row="0" Style="{StaticResource Card}" BorderBrush="#66D4AF37" Padding="20,16" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource GoldSoft}" VerticalAlignment="Center">
                  <Path Style="{StaticResource Icon}" Data="{StaticResource IcoScan}" Stroke="{StaticResource Gold}" Width="20" Height="20"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                  <TextBlock x:Name="CheckCardTitle" Text="Set the bot up for your account?" FontWeight="Bold" FontSize="15"/>
                  <TextBlock x:Name="CheckCardText" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="BtnCheckLater" Style="{StaticResource GhostBtn}" Margin="0,0,8,0">
                    <TextBlock Text="Not now" FontWeight="SemiBold" Foreground="{StaticResource Text2}"/>
                  </Button>
                  <Button x:Name="BtnCheckNow" Style="{StaticResource PrimaryBtn}" Padding="18,10">
                    <TextBlock Text="Check my game" FontWeight="Bold" Foreground="{StaticResource OnGold}"/>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,18">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="70" Height="70" CornerRadius="16" Background="{StaticResource Gold}">
                  <Border Margin="4" CornerRadius="12" BorderBrush="#55141414" BorderThickness="1.5">
                    <TextBlock x:Name="LevelText" Text="?" FontFamily="{StaticResource Display}" FontWeight="Black" FontSize="29"
                               Foreground="{StaticResource OnGold}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                </Border>
                <StackPanel Grid.Column="1" Margin="18,0,28,0" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="PlayerName" Text="Waiting for Roblox" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="22"/>
                    <TextBlock x:Name="PlayerFamily" Text="" FontFamily="{StaticResource Serif}" Foreground="{StaticResource Gold}" FontSize="16"
                               Margin="12,6,0,0"/>
                  </StackPanel>
                  <Grid Margin="0,11,0,0" Height="24">
                    <Border CornerRadius="7" Background="{StaticResource Track}"/>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="XpA" Width="0*"/>
                        <ColumnDefinition x:Name="XpB" Width="1*"/>
                      </Grid.ColumnDefinitions>
                      <Border CornerRadius="7" Background="{StaticResource Xp}"/>
                    </Grid>
                    <TextBlock x:Name="XpText" Text="" FontWeight="Bold" FontSize="12.5" Margin="11,0" VerticalAlignment="Center"/>
                  </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Text="Cash on hand" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
                  <TextBlock x:Name="CashText" Text="-" FontFamily="{StaticResource Serif}" FontSize="32" Foreground="{StaticResource Green}"
                             HorizontalAlignment="Right" Margin="0,-2,0,0"/>
                  <TextBlock x:Name="BankText" Text="" FontSize="13" Foreground="{StaticResource Text2}" HorizontalAlignment="Right"/>
                </StackPanel>
              </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" Margin="0" Padding="16,14">
                <StackPanel>
                  <Grid>
                    <TextBlock Text="Energy" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="EnergyTick" Text="" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
                  </Grid>
                  <Grid Height="26" Margin="0,8,0,0">
                    <Border CornerRadius="7" Background="{StaticResource Track}"/>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition x:Name="EnergyA" Width="0*"/><ColumnDefinition x:Name="EnergyB" Width="1*"/></Grid.ColumnDefinitions>
                      <Border CornerRadius="7" Background="{StaticResource Energy}"/>
                    </Grid>
                    <TextBlock x:Name="EnergyText" Text="-" FontWeight="Bold" FontSize="13.5" Margin="11,0" VerticalAlignment="Center"/>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="16,14">
                <StackPanel>
                  <Grid>
                    <TextBlock Text="Stamina" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="StaminaTick" Text="" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
                  </Grid>
                  <Grid Height="26" Margin="0,8,0,0">
                    <Border CornerRadius="7" Background="{StaticResource Track}"/>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition x:Name="StaminaA" Width="0*"/><ColumnDefinition x:Name="StaminaB" Width="1*"/></Grid.ColumnDefinitions>
                      <Border CornerRadius="7" Background="{StaticResource Stamina}"/>
                    </Grid>
                    <TextBlock x:Name="StaminaText" Text="-" FontWeight="Bold" FontSize="13.5" Margin="11,0" VerticalAlignment="Center"/>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Grid.Column="4" Style="{StaticResource Card}" Margin="0" Padding="16,14">
                <StackPanel>
                  <Grid>
                    <TextBlock Text="Health" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="PointsText" Text="" Style="{StaticResource Label}" Foreground="{StaticResource Gold}" HorizontalAlignment="Right"/>
                  </Grid>
                  <Grid Height="26" Margin="0,8,0,0">
                    <Border CornerRadius="7" Background="{StaticResource Track}"/>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition x:Name="HealthA" Width="0*"/><ColumnDefinition x:Name="HealthB" Width="1*"/></Grid.ColumnDefinitions>
                      <Border CornerRadius="7" Background="{StaticResource Health}"/>
                    </Grid>
                    <TextBlock x:Name="HealthText" Text="-" FontWeight="Bold" FontSize="13.5" Margin="11,0" VerticalAlignment="Center"/>
                  </Grid>
                </StackPanel>
              </Border>
            </Grid>

            <Grid Grid.Row="3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="2*" MinWidth="330"/>
              </Grid.ColumnDefinitions>

              <Border Style="{StaticResource Card}" Padding="20,18,6,6">
                <DockPanel>
                  <Grid DockPanel.Dock="Top" Margin="0,0,14,0">
                    <TextBlock Text="What the bot did" Style="{StaticResource CardTitle}"/>
                    <TextBlock x:Name="FeedCount" Text="" Style="{StaticResource Label}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  </Grid>
                  <TextBlock x:Name="FeedEmpty" DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,12,14,4"
                             Text="Nothing yet. Press Start and everything the bot does shows up here."/>
                  <ScrollViewer x:Name="FeedScroll" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                  <ItemsControl x:Name="Feed" Margin="0,0,14,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,0,0,14">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <Border Width="36" Height="36" CornerRadius="18" Background="{Binding Color}" VerticalAlignment="Top">
                            <Path Data="{Binding Icon}" Stroke="#161616" StrokeThickness="2" Width="18" Height="18" Stretch="Uniform"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                          </Border>
                          <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{Binding Who}" Foreground="{Binding Color}" FontWeight="Bold" FontSize="14"/>
                              <TextBlock Text="{Binding Time}" Foreground="#6F6B61" FontSize="12" Margin="9,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Margin="0,5,0,0" Background="#212123" CornerRadius="4,12,12,12" BorderBrush="{Binding Stripe}"
                                    BorderThickness="4,0,0,0" Padding="13,9" HorizontalAlignment="Left">
                              <TextBlock Text="{Binding Text}" TextWrapping="Wrap" TextTrimming="None" FontSize="13.5" Foreground="#D9D3C1"/>
                            </Border>
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </Border>

              <ScrollViewer x:Name="HomeSide" Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="0,0,-22,0">
              <StackPanel Margin="0,0,22,0">

                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <Grid>
                      <TextBlock Text="Help" Style="{StaticResource CardTitle}"/>
                      <TextBlock x:Name="SupportVersion" Text="" Style="{StaticResource Label}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <UniformGrid Columns="2" Margin="0,12,0,0">
                      <Button x:Name="BtnDiscord" Style="{StaticResource Btn}" Margin="0,0,4,8" Padding="10,10" ToolTip="Questions, problems or ideas? Ask in the Discord">
                        <StackPanel Orientation="Horizontal">
                          <Path Data="{StaticResource IcoDiscord}" Fill="#8C96F7" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                          <TextBlock Text="Discord" Margin="7,0,0,0" FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                      </Button>
                      <Button x:Name="BtnStar" Style="{StaticResource Btn}" Margin="4,0,0,8" Padding="10,10" ToolTip="It's free. A star on GitHub helps other players find it.">
                        <StackPanel Orientation="Horizontal">
                          <Path Data="{StaticResource IcoStar}" Fill="{StaticResource Gold}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
                          <TextBlock Text="Star on GitHub" Margin="7,0,0,0" FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                      </Button>
                      <Button x:Name="BtnDownloads" Style="{StaticResource Btn}" Margin="0,0,4,0" Padding="10,10" ToolTip="New versions come out here">
                        <StackPanel Orientation="Horizontal">
                          <Path Style="{StaticResource Icon}" Data="{StaticResource IcoDownload}" Width="15" Height="15"/>
                          <TextBlock Text="Download page" Margin="7,0,0,0" FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                      </Button>
                      <Button x:Name="BtnReportHome" Style="{StaticResource Btn}" Margin="4,0,0,0" Padding="10,10">
                        <StackPanel Orientation="Horizontal">
                          <Path Style="{StaticResource Icon}" Data="{StaticResource IcoFlag}" Width="15" Height="15"/>
                          <TextBlock x:Name="ReportHomeText" Text="Report a problem" Margin="7,0,0,0" FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                      </Button>
                    </UniformGrid>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="Up next" Style="{StaticResource CardTitle}"/>
                    <Grid Margin="0,14,0,0">
                      <TextBlock Text="Job" Style="{StaticResource Label}"/>
                      <TextBlock x:Name="JobModeText" Text="" Style="{StaticResource Label}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="JobName" Text="-" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,2" TextWrapping="Wrap" TextTrimming="None"/>
                    <TextBlock x:Name="JobMeta" Text="" Style="{StaticResource Hint}"/>
                    <Grid Height="10" Margin="0,12,0,0">
                      <Border CornerRadius="5" Background="{StaticResource Track}"/>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition x:Name="JobMasteryA" Width="0*"/><ColumnDefinition x:Name="JobMasteryB" Width="1*"/></Grid.ColumnDefinitions>
                        <Border CornerRadius="5" Background="{StaticResource Gold}"/>
                      </Grid>
                    </Grid>
                    <TextBlock x:Name="JobMasteryText" Text="" Style="{StaticResource Label}" Margin="0,7,0,0"/>
                    <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,16"/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Next boss" Style="{StaticResource Label}"/>
                      <TextBlock x:Name="BossName" Text="-" FontWeight="SemiBold" FontSize="14" Margin="0,6,0,0"/>
                      <TextBlock x:Name="BossWhen" Text="" Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                      <TextBlock Text="Heist favors" Style="{StaticResource Label}"/>
                      <TextBlock x:Name="FavorsText" Text="-" Style="{StaticResource Big}" FontSize="22" Margin="0,2,0,0"/>
                      <WrapPanel x:Name="FavorPips" Margin="0,4,0,0" Width="165" HorizontalAlignment="Left"/>
                    </StackPanel>
                  </Grid>
                    <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,16"/>
                    <TextBlock Text="Operations" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="OpsEmpty" Text="Not read yet." Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                    <ItemsControl x:Name="OpsList" Margin="0,10,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="0,0,0,10">
                            <Grid>
                              <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="#E8E2D0"/>
                              <TextBlock Text="{Binding Left}" FontSize="12.5" Foreground="#A8A292" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Height="8" Margin="0,6,0,0">
                              <Border CornerRadius="4" Background="#0D0D0E"/>
                              <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding A}"/><ColumnDefinition Width="{Binding B}"/></Grid.ColumnDefinitions>
                                <Border CornerRadius="4" Background="#5B8FB9"/>
                              </Grid>
                            </Grid>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="This session" Style="{StaticResource CardTitle}"/>
                    <UniformGrid Columns="3" Margin="0,12,0,0">
                      <StackPanel Margin="0,0,0,12"><TextBlock x:Name="TotJobs" Text="0" Style="{StaticResource Big}"/><TextBlock Text="jobs" Style="{StaticResource Label}"/></StackPanel>
                      <StackPanel Margin="0,0,0,12"><TextBlock x:Name="TotHelps" Text="0" Style="{StaticResource Big}"/><TextBlock Text="heist helps" Style="{StaticResource Label}"/></StackPanel>
                      <StackPanel Margin="0,0,0,12"><TextBlock x:Name="TotBoss" Text="0" Style="{StaticResource Big}"/><TextBlock Text="boss hits" Style="{StaticResource Label}"/></StackPanel>
                      <StackPanel><TextBlock x:Name="TotFights" Text="0" Style="{StaticResource Big}"/><TextBlock x:Name="TotFightsSub" Text="fights" Style="{StaticResource Label}"/></StackPanel>
                      <StackPanel><TextBlock x:Name="TotDeposits" Text="0" Style="{StaticResource Big}"/><TextBlock Text="deposits" Style="{StaticResource Label}"/></StackPanel>
                      <StackPanel><TextBlock x:Name="TotRewards" Text="0" Style="{StaticResource Big}"/><TextBlock Text="rewards and crates" Style="{StaticResource Label}"/></StackPanel>
                    </UniformGrid>
                  </StackPanel>
                </Border>
              </StackPanel>
              </ScrollViewer>
            </Grid>
          </Grid>
        </ScrollViewer>

        <ScrollViewer x:Name="PageJobs" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <Grid Margin="30,0,30,30"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="1100"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <HeaderedContentControl Style="{StaticResource Section}" Header="Jobs" Tag="{StaticResource IcoJobs}">
              <StackPanel>
                <CheckBox x:Name="sw_Jobs" Style="{StaticResource Switch}">
                  <StackPanel>
                    <TextBlock Text="Do jobs" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="Each job costs energy and gives cash, XP and mastery." Style="{StaticResource Hint}"/>
                  </StackPanel>
                </CheckBox>
                <TextBlock Text="Which job" Style="{StaticResource Label}" Margin="0,22,0,8"/>
                <Border Style="{StaticResource SegmentBar}">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="seg_JobMode_BestXp" GroupName="jobmode" Style="{StaticResource Segment}" Content="Best XP"/>
                    <RadioButton x:Name="seg_JobMode_Mastery" GroupName="jobmode" Style="{StaticResource Segment}" Content="Finish mastery"/>
                    <RadioButton x:Name="seg_JobMode_OneJob" GroupName="jobmode" Style="{StaticResource Segment}" Content="One job"/>
                  </StackPanel>
                </Border>
                <TextBlock x:Name="JobModeHint" Style="{StaticResource Hint}" Margin="0,10,0,0"/>

                <Border x:Name="OneJobWhyBox" CornerRadius="10" Background="{StaticResource Panel2}" Padding="12,8" Margin="0,12,0,0" HorizontalAlignment="Left" Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IcoBolt}" Stroke="{StaticResource Energy}" Width="14" Height="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OneJobWhy" FontSize="13" Foreground="{StaticResource Text}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource Section}" Header="Heists" Tag="{StaticResource IcoHeist}">
              <StackPanel>
                <CheckBox x:Name="sw_Heists" Style="{StaticResource Switch}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Help heists" FontWeight="SemiBold" FontSize="15"/>
                    </StackPanel>
                    <TextBlock Text="Your family's first, then only the ones worth more XP." Style="{StaticResource Hint}"/>
                  </StackPanel>
                </CheckBox>
                <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,18"/>
                <CheckBox x:Name="sw_HeistsFamilyOnly" Style="{StaticResource Switch}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Only my family's heists" FontWeight="SemiBold" FontSize="15"/>
                    </StackPanel>
                    <TextBlock Text="The rest of your energy goes to jobs." Style="{StaticResource Hint}"/>
                  </StackPanel>
                </CheckBox>
                <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,18"/>

                <CheckBox x:Name="sw_StartHeists" Style="{StaticResource Switch}">
                  <StackPanel>
                    <TextBlock Text="Start my own heist" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="Starts the heist picked below. A failed heist loses its stake." Style="{StaticResource Hint}"/>
                  </StackPanel>
                </CheckBox>
                <ComboBox x:Name="cmb_StartHeist" Width="300" HorizontalAlignment="Left" Margin="0,10,0,0" ToolTip="Which heist the bot starts"/>
              </StackPanel>
            </HeaderedContentControl>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <Grid>
                  <TextBlock Text="Mastery" Style="{StaticResource CardTitle}"/>
                  <TextBlock x:Name="MasterySummary" Text="" Style="{StaticResource Label}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,14"
                           Text="Bronze at 25 jobs, Silver at 50, Gold at 100. Gold gives a skill point."/>
                <ItemsControl x:Name="JobList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid>

                        <Button Command="{Binding Toggle}" Cursor="Hand" Focusable="False" Margin="0,8,0,6" HorizontalContentAlignment="Stretch">
                          <Button.Style>
                            <Style TargetType="Button">
                              <Setter Property="Template">
                                <Setter.Value>
                                  <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bar" CornerRadius="10" Background="#212123" BorderBrush="#D4AF37" BorderThickness="0,0,0,1.5" Padding="16,10,12,10">
                                      <ContentPresenter HorizontalAlignment="Stretch"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Background" Value="#2A2A2D"/></Trigger>
                                    </ControlTemplate.Triggers>
                                  </ControlTemplate>
                                </Setter.Value>
                              </Setter>
                              <Style.Triggers><DataTrigger Binding="{Binding IsHeader}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                            </Style>
                          </Button.Style>
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Header}" FontFamily="Palatino Linotype, Georgia" FontSize="17" Foreground="#D4AF37" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="12.5" Foreground="#A8A292" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Border Grid.Column="2" Width="26" Height="26" CornerRadius="5" BorderBrush="#D4AF37" BorderThickness="1.5">
                              <TextBlock Text="{Binding Sign}" FontSize="18" FontWeight="Bold" Foreground="#D4AF37" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/>
                            </Border>
                          </Grid>
                        </Button>

                        <Button Command="{Binding Pick}" IsEnabled="{Binding Pickable}" Focusable="False" Margin="0,0,0,3" HorizontalContentAlignment="Stretch">
                          <Button.Style>
                            <Style TargetType="Button">
                              <Setter Property="Background" Value="{Binding RowBg}"/>
                              <Setter Property="Template">
                                <Setter.Value>
                                  <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="10" Padding="12,8" Background="{TemplateBinding Background}">
                                      <ContentPresenter HorizontalAlignment="Stretch"/>
                                    </Border>
                                  </ControlTemplate>
                                </Setter.Value>
                              </Setter>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHeader}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                <DataTrigger Binding="{Binding Pickable}" Value="True"><Setter Property="Cursor" Value="Hand"/></DataTrigger>
                                <MultiDataTrigger>
                                  <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Hover}" Value="True"/>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                  </MultiDataTrigger.Conditions>
                                  <Setter Property="Background" Value="#262628"/>
                                </MultiDataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="80"/>
                              <ColumnDefinition Width="80"/>
                              <ColumnDefinition Width="170"/>
                              <ColumnDefinition Width="96"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" FontSize="13.5" Foreground="{Binding NameBrush}" FontWeight="{Binding NameWeight}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Cost}" FontSize="13" Foreground="#E08C32" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="{Binding Xp}" FontSize="13" Foreground="#A8A292" HorizontalAlignment="Right"/>
                            <Grid Grid.Column="3" Height="8" Margin="18,0,0,0" VerticalAlignment="Center">
                              <Border CornerRadius="4" Background="#0D0D0E"/>
                              <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding A}"/><ColumnDefinition Width="{Binding B}"/></Grid.ColumnDefinitions>
                                <Border CornerRadius="4" Background="{Binding RankBrush}"/>
                              </Grid>
                            </Grid>
                            <TextBlock Grid.Column="4" Text="{Binding Rank}" FontSize="12.5" FontWeight="SemiBold" Foreground="{Binding RankBrush}" HorizontalAlignment="Right"/>
                          </Grid>
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel></Grid>
        </ScrollViewer>

        <ScrollViewer x:Name="PageCombat" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <Grid Margin="30,0,30,30"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="1100"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <HeaderedContentControl Style="{StaticResource Section}" Header="Bosses" Tag="{StaticResource IcoCrown}">
              <StackPanel>
                <CheckBox x:Name="sw_Bosses" Style="{StaticResource Switch}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Fight bosses" FontWeight="SemiBold" FontSize="15"/>
                    </StackPanel>
                    <TextBlock Text="Climbs the stages, again after the daily reset." Style="{StaticResource Hint}"/>
                  </StackPanel>
                </CheckBox>
                <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                           Text="The stamina they keep: Stamina perks, below."/>
              </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource Section}" Header="Other players" Tag="{StaticResource IcoSwords}">
              <StackPanel>
                <CheckBox x:Name="sw_Fights" Style="{StaticResource Switch}">
                  <StackPanel>
                    <TextBlock Text="Attack other players" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="Lowest level first, each player once, then a new list." Style="{StaticResource Hint}"/>
                  </StackPanel>
                </CheckBox>
                <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,18"/>
                <CheckBox x:Name="sw_WarTargetsOnly" Style="{StaticResource Switch}">
                  <StackPanel>
                    <TextBlock Text="Only attack war targets" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="During a war, only the war targets." Style="{StaticResource Hint}"/>
                  </StackPanel>
                </CheckBox>
                <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,18"/>
                <CheckBox x:Name="sw_ScoutFights" Style="{StaticResource Switch}">
                  <StackPanel>
                    <TextBlock Text="Scout players first" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="Skips anyone stronger than you (1 stamina)." Style="{StaticResource Hint}"/>
                  </StackPanel>
                </CheckBox>
                <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,18"/>

                <CheckBox x:Name="sw_WhaleHunt" Style="{StaticResource Switch}">
                  <StackPanel>

                    <TextBlock Text="Bank and hit big wins again" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="Hits a player again after a big win, up to 5 times." Style="{StaticResource Hint}"/>
                  </StackPanel>
                </CheckBox>
                <ComboBox x:Name="cmb_WhaleCash" Width="300" HorizontalAlignment="Left" Margin="0,10,0,0" ToolTip="What a win must take for the bot to hit that player again"/>
                <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,18"/>

                <CheckBox x:Name="sw_RememberPlayers" Style="{StaticResource Switch}">
                  <StackPanel>
                    <TextBlock Text="Remember players" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="Big payers first, skips who beat you twice for 2 days." Style="{StaticResource Hint}"/>
                  </StackPanel>
                </CheckBox>
              </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource Section}" Header="Stamina perks" Tag="{StaticResource IcoBolt}">
              <StackPanel>
                <CheckBox x:Name="sw_GiveStamina" Style="{StaticResource Switch}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Give stamina to a perk" FontWeight="SemiBold" FontSize="15"/>
                    </StackPanel>
                    <TextBlock Text="All stamina above the number below." Style="{StaticResource Hint}"/>
                  </StackPanel>
                </CheckBox>
                <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,18"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Keep stamina for bosses and fights" FontWeight="SemiBold" FontSize="15"/>
                    </StackPanel>
                    <TextBlock Text="Half your stamina bar at most." Style="{StaticResource Hint}"/>
                  </StackPanel>
                  <ContentControl x:Name="num_FightStaminaReserve" Grid.Column="1" Tag="0,500,1," VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="Give it to" Style="{StaticResource Label}" Margin="0,16,0,8"/>
                <ComboBox x:Name="cmb_StaminaPerk" Width="300" HorizontalAlignment="Left"/>
                <TextBlock x:Name="PerkHint" Style="{StaticResource Hint}" Margin="0,8,0,0"/>

                <Border x:Name="GiveWhyBox" CornerRadius="10" Background="{StaticResource Panel2}" Padding="12,8" Margin="0,12,0,0" HorizontalAlignment="Left" Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IcoBolt}" Stroke="{StaticResource Stamina}" Width="14" Height="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="GiveWhy" FontSize="13" Foreground="{StaticResource Text}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
                <Grid Margin="0,22,0,10">
                  <TextBlock Text="Your family's stamina perks" FontWeight="SemiBold" FontSize="15"/>
                  <TextBlock x:Name="PerksRead" Text="" Style="{StaticResource Label}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="PerksEmpty" Text="Not read yet." Style="{StaticResource Hint}"/>
                <ItemsControl x:Name="PerkList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border CornerRadius="10" Padding="12,8" Background="{Binding RowBg}" Margin="0,0,0,3">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="110"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="13.5" Foreground="{Binding NameBrush}" FontWeight="{Binding NameWeight}"/>
                            <TextBlock Text="{Binding Effect}" FontSize="12" Foreground="#A8A292"/>
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding Level}" FontSize="13" Foreground="#D4AF37" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                          <Grid Grid.Column="2" Height="8" Margin="18,0,0,0" VerticalAlignment="Center">
                            <Border CornerRadius="4" Background="#0D0D0E"/>
                            <Grid>
                              <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding A}"/><ColumnDefinition Width="{Binding B}"/></Grid.ColumnDefinitions>
                              <Border CornerRadius="4" Background="#5B8FB9"/>
                            </Grid>
                          </Grid>
                          <TextBlock Grid.Column="3" Text="{Binding Progress}" FontSize="12.5" FontWeight="SemiBold" Foreground="#A8A292" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource Section}" Header="Takedown" Tag="{StaticResource IcoCrown}">
              <StackPanel>
                <CheckBox x:Name="sw_Takedown" Style="{StaticResource Switch}">
                  <StackPanel>
                    <TextBlock Text="Use free Takedown attacks" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="The family's weekly boss. It never uses tickets." Style="{StaticResource Hint}"/>
                  </StackPanel>
                </CheckBox>
                <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,18,0,16"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Your damage this week" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="TdDamage" Text="-" Style="{StaticResource Big}" Margin="0,2,0,0"/>
                    <TextBlock x:Name="TdPlace" Text="" Style="{StaticResource Hint}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="Free attacks" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="TdFree" Text="-" Style="{StaticResource Big}" Margin="0,2,0,0"/>
                    <WrapPanel x:Name="TdPips" Margin="0,6,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Margin="12,0,0,0">
                    <TextBlock x:Name="TdStageLabel" Text="Stage" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="TdStage" Text="-" FontWeight="SemiBold" FontSize="14.5" Margin="0,5,0,0"/>
                    <Grid Height="8" Margin="0,9,0,0">
                      <Border CornerRadius="4" Background="{StaticResource Track}"/>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition x:Name="TdHpA" Width="0*"/><ColumnDefinition x:Name="TdHpB" Width="1*"/></Grid.ColumnDefinitions>
                        <Border CornerRadius="4" Background="{StaticResource Health}"/>
                      </Grid>
                    </Grid>
                    <TextBlock x:Name="TdHp" Text="" Style="{StaticResource Label}" Margin="0,6,0,0"/>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="TdRead" Style="{StaticResource Hint}" Margin="0,16,0,0" Text=""/>
              </StackPanel>
            </HeaderedContentControl>

            <Border Style="{StaticResource Card}" Padding="20,18">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="70" Height="70" CornerRadius="16" Background="{StaticResource Gold}">
                    <Border Margin="4" CornerRadius="12" BorderBrush="#55141414" BorderThickness="1.5">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="FamLevel" Text="?" FontFamily="{StaticResource Display}" FontWeight="Black" FontSize="27"
                                   Foreground="{StaticResource OnGold}" HorizontalAlignment="Center" Margin="0,-3,0,0"/>
                        <TextBlock Text="LEVEL" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource OnGold}" HorizontalAlignment="Center" Margin="0,-4,0,0"/>
                      </StackPanel>
                    </Border>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="18,0,28,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock x:Name="FamName" Text="Your family" FontFamily="{StaticResource Serif}" FontSize="25"/>
                      <TextBlock x:Name="FamTag" Text="" FontFamily="{StaticResource Serif}" Foreground="{StaticResource Gold}" FontSize="18" Margin="12,7,0,0"/>
                    </StackPanel>
                    <Grid Margin="0,10,0,0" Height="24">
                      <Border CornerRadius="7" Background="{StaticResource Track}"/>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition x:Name="FamXpA" Width="0*"/>
                          <ColumnDefinition x:Name="FamXpB" Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="7" Background="{StaticResource Xp}"/>
                      </Grid>
                      <TextBlock x:Name="FamXpText" Text="" FontWeight="Bold" FontSize="12.5" Margin="11,0" VerticalAlignment="Center"/>
                    </Grid>
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Family vault" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="FamVault" Text="-" FontFamily="{StaticResource Serif}" FontSize="32" Foreground="{StaticResource Green}"
                               HorizontalAlignment="Right" Margin="0,-2,0,0"/>
                    <TextBlock x:Name="FamGold" Text="" FontSize="13" Foreground="{StaticResource Gold}" HorizontalAlignment="Right"/>
                  </StackPanel>
                </Grid>
                <UniformGrid Columns="4" Margin="0,18,0,0">
                  <StackPanel><TextBlock x:Name="FamMembers" Text="-" Style="{StaticResource Big}" FontSize="21"/><TextBlock Text="members" Style="{StaticResource Label}"/></StackPanel>
                  <StackPanel><TextBlock x:Name="FamRespect" Text="-" Style="{StaticResource Big}" FontSize="21"/><TextBlock Text="family respect" Style="{StaticResource Label}"/></StackPanel>
                  <StackPanel><TextBlock x:Name="FamPerkLevels" Text="-" Style="{StaticResource Big}" FontSize="21"/><TextBlock Text="perk levels" Style="{StaticResource Label}"/></StackPanel>
                  <StackPanel><TextBlock x:Name="FamTerritories" Text="-" Style="{StaticResource Big}" FontSize="21"/><TextBlock Text="territories" Style="{StaticResource Label}"/></StackPanel>
                </UniformGrid>
                <TextBlock x:Name="FamRead" Style="{StaticResource Hint}" Margin="0,16,0,0" Text=""/>
                <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,18,0,18"/>
                <CheckBox x:Name="sw_FamilyWatch" Style="{StaticResource Switch}">
                  <StackPanel>
                    <TextBlock Text="Watch my family" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="Reads the family pages every 3 hours. It only reads." Style="{StaticResource Hint}"/>
                  </StackPanel>
                </CheckBox>
              </StackPanel>
            </Border>
          </StackPanel></Grid>
        </ScrollViewer>

        <ScrollViewer x:Name="PageCrew" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <Grid Margin="30,0,30,30"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="1100"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>

            <Border Style="{StaticResource Card}" Padding="20,18">
              <StackPanel>
                <Grid>
                  <TextBlock Text="Your crew" Style="{StaticResource CardTitle}"/>
                  <TextBlock x:Name="CrewWhen" Text="" Style="{StaticResource Label}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <UniformGrid Columns="4" Margin="0,14,0,0">
                  <StackPanel><TextBlock x:Name="CrewCount" Text="-" Style="{StaticResource Big}"/><TextBlock Text="henchmen" Style="{StaticResource Label}"/></StackPanel>
                  <StackPanel><TextBlock x:Name="CrewAttack" Text="-" Style="{StaticResource Big}"/><TextBlock Text="crew attack" Style="{StaticResource Label}"/></StackPanel>
                  <StackPanel><TextBlock x:Name="CrewDefense" Text="-" Style="{StaticResource Big}"/><TextBlock Text="crew defense" Style="{StaticResource Label}"/></StackPanel>
                  <StackPanel><TextBlock x:Name="CrewSlot" Text="-" Style="{StaticResource Big}" Foreground="{StaticResource Green}"/><TextBlock Text="next slot" Style="{StaticResource Label}"/></StackPanel>
                </UniformGrid>

                <Grid x:Name="CrewBar" Height="14" Margin="0,18,0,0"/>
                <WrapPanel x:Name="CrewChips" Margin="0,10,0,0"/>
                <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,12,0,14"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Path Style="{StaticResource Icon}" Data="{StaticResource IcoCrew}" Stroke="{StaticResource Text3}" Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,10,0"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock x:Name="CrewStatus" Style="{StaticResource Hint}" Foreground="{StaticResource Text}" Text="Not read yet. The bot looks at your crew every 30 minutes."/>
                    <TextBlock x:Name="CrewSession" Style="{StaticResource Hint}" Margin="0,4,0,0" Text=""/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <CheckBox x:Name="RerollOnlySwitch" Style="{StaticResource Switch}">
                <StackPanel>
                  <TextBlock Text="Only reroll the crew" FontWeight="SemiBold" FontSize="15"/>
                  <TextBlock x:Name="RerollOnlyHint" Style="{StaticResource Hint}" TextWrapping="Wrap"
                             Text="Does nothing else. Stops when your crew is maxed or the cash on hand runs out."/>
                </StackPanel>
              </CheckBox>
            </Border>

            <HeaderedContentControl Style="{StaticResource Section}" Header="Hiring and rerolls" Tag="{StaticResource IcoCrew}">
              <StackPanel>
                <CheckBox x:Name="sw_CrewSlots" Style="{StaticResource Switch}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Buy new crew slots" FontWeight="SemiBold" FontSize="15"/>
                    </StackPanel>
                    <TextBlock Text="When you have the cash, after the next property." Style="{StaticResource Hint}"/>
                  </StackPanel>
                </CheckBox>
                <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,18"/>
                <CheckBox x:Name="sw_CrewFill" Style="{StaticResource Switch}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Hire into empty slots" FontWeight="SemiBold" FontSize="15"/>
                    </StackPanel>
                    <TextBlock Text="With the hire below, or a cheaper one." Style="{StaticResource Hint}"/>
                  </StackPanel>
                </CheckBox>
                <TextBlock Text="Hire with" Style="{StaticResource Label}" Margin="0,16,0,8"/>
                <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="seg_CrewRollType_Street" GroupName="crewroll" Style="{StaticResource Segment}" Content="Street $10K"/>
                    <RadioButton x:Name="seg_CrewRollType_Professional" GroupName="crewroll" Style="{StaticResource Segment}" Content="Professional $10M"/>
                    <RadioButton x:Name="seg_CrewRollType_Elite" GroupName="crewroll" Style="{StaticResource Segment}" Content="Elite $10B"/>
                  </StackPanel>
                </Border>

                <WrapPanel x:Name="CrewOdds" Margin="0,10,0,0"/>
                <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,14,0,18"/>
                <CheckBox x:Name="sw_CrewReroll" Style="{StaticResource Switch}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Reroll the worst henchman" FontWeight="SemiBold" FontSize="15"/>
                    </StackPanel>
                    <TextBlock Text="Until everyone has the best rarity the hire can roll." Style="{StaticResource Hint}"/>
                  </StackPanel>
                </CheckBox>

                <TextBlock x:Name="CrewRollHint" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,18"/>

                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Then, once everyone has the best rarity" FontWeight="SemiBold" FontSize="15"/>
                </StackPanel>
                <TextBlock Text="Then by their own attack and defense." Style="{StaticResource Hint}"/>
                <ComboBox x:Name="cmb_CrewRerollStats" Width="300" HorizontalAlignment="Left" Margin="0,10,0,0"/>              </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource Section}" Header="Training" Tag="{StaticResource IcoStar}">
              <StackPanel>
                <CheckBox x:Name="sw_TrainCrew" Style="{StaticResource Switch}">
                  <StackPanel>
