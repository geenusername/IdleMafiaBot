            <HeaderedContentControl Style="{StaticResource Section}" Header="What it never presses" Tag="{StaticResource IcoShield}">
              <StackPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Anything that costs Robux or tickets, the + refill buttons, FINISH NOW, REPLACE, SABOTAGE, START A HEIST, DELETE, AUTO ROLL, a collection card's own DEPOSIT, LEAVE FAMILY, MAKE BOSS, DONATE, DECLARE WAR, INVITE, EDIT, SAVE, JOIN, STOP on a henchman in training, briefcase keys, Trade and the Black Market."/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Text="Only when their switches are on, and only with your cash: BUILD on Properties, UPGRADE on the Safehouse, UNLOCK SLOT and the hires on the Crew, DISMISS on your worst henchman to reroll it, TRAIN on your best, and WITHDRAW ALL at the bank for one of those purchases. Also only in these cases: DEMOLISH on your weakest property when a better one is ready to build, UNEQUIP ALL to read your crew's own stats for rerolls (with AUTO EQUIP BEST right after), SCOUT on a player's profile before a fight (1 stamina, with Scout players first on), START on a heist of your own (with Start my own heist on), and CANCEL to back out of a crew or property window it won't go ahead with."/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Text="In the Shop it only buys items priced in cash. If a Robux purchase window opens, it stops."/>
              </StackPanel>
            </HeaderedContentControl>
          </StackPanel></Grid>
        </ScrollViewer>
      </Grid>
    </Grid>

    <Grid x:Name="Review" Grid.ColumnSpan="2" Background="#E6070708" Visibility="Collapsed">

        <Border Style="{StaticResource Card}" MaxWidth="1060" Margin="30" Padding="30,24,30,20" BorderBrush="{StaticResource Line}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border Width="58" Height="58" CornerRadius="16" Background="{StaticResource Rail}">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IcoScan}" Stroke="{StaticResource Gold}" Width="26" Height="26"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Your game, checked" Style="{StaticResource PageTitle}" FontSize="28"/>
                <TextBlock x:Name="ReviewSub" Text="" Style="{StaticResource Label}" Margin="1,2,0,0"/>
              </StackPanel>
              <Button x:Name="BtnReviewClose" Grid.Column="2" Style="{StaticResource WinBtn}" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close (your settings stay as they are)">
                <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource Text2}" StrokeThickness="1.2"/>
              </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,-16,0">
            <Grid Margin="0,0,16,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="3*"/>
              </Grid.ColumnDefinitions>

              <StackPanel>
                <TextBlock Text="WHAT I FOUND" Style="{StaticResource Label}" Foreground="{StaticResource Gold}" Margin="0,0,0,12"/>
                <ItemsControl x:Name="FoundList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,11">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="#6F6B61" Margin="0,1,8,0" TextWrapping="Wrap" TextTrimming="None"/>
                        <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="13.5" Foreground="#E8E2D0" TextWrapping="Wrap" TextTrimming="None"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Grid.Column="2">
                <TextBlock Text="WHAT I'D SET UP" Style="{StaticResource Label}" Foreground="{StaticResource Gold}" Margin="0,0,0,12"/>
                <TextBlock Text="Your focus" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                <Border Style="{StaticResource SegmentBar}">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="seg_Focus_Balanced" GroupName="focus" Style="{StaticResource Segment}" Content="Balanced"/>
                    <RadioButton x:Name="seg_Focus_XP" GroupName="focus" Style="{StaticResource Segment}" Content="XP"/>
                    <RadioButton x:Name="seg_Focus_Money" GroupName="focus" Style="{StaticResource Segment}" Content="Money"/>
                    <RadioButton x:Name="seg_Focus_Family" GroupName="focus" Style="{StaticResource Segment}" Content="Family"/>
                  </StackPanel>
                </Border>
                <TextBlock x:Name="FocusHint" Style="{StaticResource Hint}" Margin="0,8,0,18"/>
                <TextBlock x:Name="ChangesEmpty" Text="Your settings already fit your game." Style="{StaticResource Hint}" Margin="0,0,0,8" Visibility="Collapsed"/>
                <ItemsControl x:Name="ChangeList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border CornerRadius="10" Background="#212123" Padding="14,10" Margin="0,0,0,6">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <StackPanel>
                            <WrapPanel>
                              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#E8E2D0" Margin="0,0,10,0"/>
                              <TextBlock Text="{Binding Old}" FontSize="13" Foreground="#6F6B61" TextDecorations="Strikethrough" VerticalAlignment="Bottom"/>
                              <TextBlock Text="  &#8594;  " FontSize="13" Foreground="#6F6B61" VerticalAlignment="Bottom"/>
                              <TextBlock Text="{Binding New}" FontSize="13" FontWeight="Bold" Foreground="#D4AF37" VerticalAlignment="Bottom"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding Reason}" FontSize="12.5" Foreground="#A8A292" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0"/>

                            <TextBlock Text="{Binding Note}" FontSize="12.5" FontWeight="SemiBold" Foreground="#D4AF37" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Style.Triggers><DataTrigger Binding="{Binding Note}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </StackPanel>
                          <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding Use, Mode=TwoWay}" VerticalAlignment="Center" Margin="16,0,0,0"
                                    ToolTip="On: use this. Off: keep your own setting."/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="KeptTitle" Text="ALREADY SET LIKE THIS" Style="{StaticResource Label}" Margin="0,16,0,10"/>
                <ItemsControl x:Name="KeptList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,0,0,9">
                        <WrapPanel>
                          <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#A8A292" Margin="0,0,8,0"/>
                          <TextBlock Text="{Binding New}" FontSize="13" Foreground="#A8A292"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding Reason}" FontSize="12" Foreground="#6F6B61" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0"/>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Grid>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,16,0,0">
              <Border Height="1" Background="{StaticResource LineSoft}" VerticalAlignment="Top" Margin="0,-2,0,0"/>
              <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="ReviewNote" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,20,0"
                         Text="Nothing changes until you press Use these settings. Switch a line off to keep your own setting."/>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnKeepSettings" Style="{StaticResource GhostBtn}" Margin="0,0,10,0">
                  <TextBlock x:Name="KeepText" Text="Keep my settings" FontWeight="SemiBold" Foreground="{StaticResource Text2}"/>
                </Button>
                <Button x:Name="BtnUseSettings" Style="{StaticResource PrimaryBtn}" Padding="24,11" MinWidth="180">
                  <TextBlock x:Name="UseText" Text="Use these settings" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource OnGold}"/>
                </Button>
              </StackPanel>
              </Grid>
            </Grid>
          </Grid>
        </Border>
    </Grid>

    <Grid x:Name="Welcome" Grid.ColumnSpan="2" Background="#E6070708" Visibility="Collapsed">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Width="760" Margin="30" Padding="36,30" HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="{StaticResource Line}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Width="58" Height="58" CornerRadius="16" Background="{StaticResource Rail}">
                <Path Data="{StaticResource IcoFedora}" Fill="{StaticResource Gold}" Width="38" Height="38" Stretch="Uniform"/>
              </Border>
              <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Welcome to Idle Mafia Bot" Style="{StaticResource PageTitle}" FontSize="28"/>
                <TextBlock x:Name="WelcomeVersion" Text="" Style="{StaticResource Label}" Margin="1,1,0,0"/>
              </StackPanel>
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" FontSize="14" Foreground="{StaticResource Text}" Margin="0,20,0,0"
                       Text="It plays Idle Mafia Game on Roblox for you. Every part has its own switch on the pages on the left."/>

            <Grid Margin="0,20,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource GoldSoft}" VerticalAlignment="Top">
                <Path Data="{StaticResource IcoPlay}" Fill="{StaticResource Gold}" Width="13" Height="13" Stretch="Uniform"/>
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Start and stop" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                           Text="Open the game in Roblox, at any window size, and press Start or F6. While you use the PC it waits, then borrows the mouse for a few seconds."/>
              </StackPanel>
            </Grid>
            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource GoldSoft}" VerticalAlignment="Top">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IcoScan}" Stroke="{StaticResource Gold}" Width="18" Height="18"/>
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="It only looks and clicks" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                           Text="It reads the screen and moves the mouse, like you would. It never changes Roblox."/>
              </StackPanel>
            </Grid>
            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource GoldSoft}" VerticalAlignment="Top">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IcoShield}" Stroke="{StaticResource Gold}" Width="18" Height="18"/>
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="What it never presses" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                           Text="Anything that costs Robux, and risky buttons like DELETE, SABOTAGE or LEAVE&#160;FAMILY. The full list is in Settings. If a Robux purchase window opens, it stops."/>
              </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource Hint}" Margin="0,20,0,0"
                       Text="Updating from an older version? Put this IdleMafiaBot.exe in your old folder, in place of the old one, so your settings stay. After that, Check for updates on the Settings page does it for you."/>

            <Grid Margin="0,26,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Button x:Name="BtnWelcomeDiscord" Style="{StaticResource PrimaryBtn}" Background="#5865F2" Padding="18,11"
                      ToolTip="Questions, problems or ideas? Ask in the Discord">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource IcoDiscord}" Fill="White" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"/>
                  <TextBlock Text="Join the Discord" Margin="9,0,0,0" FontWeight="Bold" FontSize="14.5" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="BtnWelcomeOk" Grid.Column="2" Style="{StaticResource PrimaryBtn}" Padding="24,11" MinWidth="160">
                <TextBlock Text="Let's go" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource OnGold}"/>
              </Button>
            </Grid>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Grid>

    <Grid x:Name="Rules" Grid.ColumnSpan="2" Background="#F0070708" Visibility="Collapsed">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Width="760" Margin="30" Padding="36,30" HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="{StaticResource Line}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Width="58" Height="58" CornerRadius="16" Background="{StaticResource Rail}">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IcoShield}" Stroke="{StaticResource Gold}" Width="34" Height="34"/>
              </Border>
              <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Guidelines" Style="{StaticResource PageTitle}" FontSize="28"/>
                <TextBlock Text="Shown every time the app starts" Style="{StaticResource Label}" Margin="1,1,0,0"/>
              </StackPanel>
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" FontSize="14" Foreground="{StaticResource Text}" Margin="0,18,0,0"
                       Text="Idle Mafia Bot is free and made to keep your own game going while you're away. By using it you agree to these rules."/>

            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource GoldSoft}" VerticalAlignment="Top">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IcoCrew}" Stroke="{StaticResource Gold}" Width="18" Height="18"/>
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Only your own account" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                           Text="Play your own game with it. Don't run it on other people's accounts, and don't level up accounts for others."/>
              </StackPanel>
            </Grid>
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource GoldSoft}" VerticalAlignment="Top">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IcoBank}" Stroke="{StaticResource Gold}" Width="18" Height="18"/>
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Never sell accounts" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                           Text="Don't sell, buy or trade accounts or game items for real money. Roblox doesn't allow it."/>
              </StackPanel>
            </Grid>
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource GoldSoft}" VerticalAlignment="Top">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IcoFlag}" Stroke="{StaticResource Gold}" Width="18" Height="18"/>
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Follow Roblox's rules and the game's" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                           Text="Stick to the Roblox Terms of Use, the Community Standards and the game's own rules. If they ever say no to macros like this one, stop using it."/>
              </StackPanel>
            </Grid>
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource GoldSoft}" VerticalAlignment="Top">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IcoLock}" Stroke="{StaticResource Gold}" Width="18" Height="18"/>
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Keep your account safe" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                           Text="Download the bot only from github.com/geenusername/IdleMafiaBot. It never asks for your password, so never give it to anyone."/>
              </StackPanel>
            </Grid>
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource GoldSoft}" VerticalAlignment="Top">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IcoDownload}" Stroke="{StaticResource Gold}" Width="18" Height="18"/>
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Share it, don't sell it" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                           Text="The bot is free. Don't sell it or upload copies of it. Send people the GitHub page instead, and only post it where that's allowed."/>
              </StackPanel>
            </Grid>

            <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,24,0,0"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,16,0,0"
                       Text="You are responsible for how you use the bot and for your own account. The maker of this app is not responsible for what you do with it. If you don't agree, press Close and the app closes."/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
              <Button x:Name="BtnRulesClose" Style="{StaticResource GhostBtn}" Margin="0,0,10,0">
                <TextBlock Text="Close" FontWeight="SemiBold" Foreground="{StaticResource Text2}"/>
              </Button>
              <Button x:Name="BtnRulesAgree" Style="{StaticResource PrimaryBtn}" Padding="24,11" MinWidth="160">
                <TextBlock Text="I agree" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource OnGold}"/>
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
