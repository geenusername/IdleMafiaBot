<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Idle Mafia Bot" Width="1260" Height="840" ResizeMode="NoResize"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Sans}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid x:Name="Root">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="0"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Grid Visibility="Collapsed">
      <Ellipse x:Name="RunGlow" Width="22" Height="22" Fill="{StaticResource Text3}" Opacity="0.18"/>
      <Ellipse x:Name="RunLamp" Width="10" Height="10" Fill="{StaticResource Text3}"/>
    </Grid>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="84"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Viewbox Grid.RowSpan="3" Stretch="UniformToFill" VerticalAlignment="Bottom" Height="250" IsHitTestVisible="False" Opacity="0.6">
        <Canvas Width="1600" Height="240">
          <Path Data="{StaticResource SkylineFar}" Fill="{StaticResource SkylineFarFill}" Visibility="{DynamicResource MafiaVisibility}"/>
          <Path Data="{StaticResource SkylineNear}" Fill="{StaticResource SkylineNearFill}" Visibility="{DynamicResource MafiaVisibility}"/>
          <Path x:Name="SkyWinBack" Data="{StaticResource SkylineWindows}" Fill="{StaticResource SkylineWinFill}" Opacity="0.3" Visibility="{DynamicResource MafiaVisibility}">
            <Path.Triggers>
              <EventTrigger RoutedEvent="Path.Loaded">
                <BeginStoryboard>
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
                      <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.3"/>
                      <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="0.36"/>
                      <DiscreteDoubleKeyFrame KeyTime="0:0:1.1" Value="0.24"/>
                      <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="0.33"/>
                      <DiscreteDoubleKeyFrame KeyTime="0:0:2.2" Value="0.28"/>
                      <LinearDoubleKeyFrame KeyTime="0:0:3.1" Value="0.3"/>
                    </DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Path.Triggers>
          </Path>
          <Ellipse x:Name="MoonGlow" Canvas.Left="1258" Canvas.Top="13" Width="120" Height="120" Fill="{StaticResource SkylineWinFill}" Opacity="0.12" Visibility="{DynamicResource HalloweenVisibility}">
            <Ellipse.Triggers>
              <EventTrigger RoutedEvent="Ellipse.Loaded">
                <BeginStoryboard>
                  <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.08" To="0.2" Duration="0:0:2.6"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Ellipse.Triggers>
          </Ellipse>
          <Image x:Name="ImgBack" Visibility="{DynamicResource HalloweenVisibility}" Canvas.Left="0" Canvas.Top="0" Width="1600" Height="240" Stretch="Fill"/>
          <Image x:Name="ImgMid" Visibility="{DynamicResource HalloweenVisibility}" Canvas.Left="272" Canvas.Top="0" Width="1056" Height="240" Stretch="Fill"/>
          <Image x:Name="ImgTomb" Visibility="{DynamicResource HalloweenVisibility}" Canvas.Left="1140" Canvas.Top="45" Width="110" Stretch="Uniform" Opacity="0.85"/>
          <TextBlock x:Name="TombLosses" Visibility="{DynamicResource HalloweenVisibility}" Canvas.Left="1140" Canvas.Top="128" Width="110" Text="0"
                     TextAlignment="Center" FontFamily="{StaticResource Deco}" FontSize="30" FontWeight="Bold" Foreground="#241F33" IsHitTestVisible="False"/>
          <TextBlock x:Name="TombWins" Visibility="{DynamicResource HalloweenVisibility}" Canvas.Left="1140" Canvas.Top="166" Width="110" Text=""
                     TextAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text2}" IsHitTestVisible="False"/>
          <Image x:Name="ImgFog" Visibility="{DynamicResource HalloweenVisibility}" Canvas.Left="-100" Canvas.Top="91" Width="1800" Height="149" Stretch="Fill" Opacity="0.7">
            <Image.RenderTransform><TranslateTransform X="0"/></Image.RenderTransform>
            <Image.Triggers>
              <EventTrigger RoutedEvent="Image.Loaded">
                <BeginStoryboard>
                  <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="-60" To="60" Duration="0:0:23" RepeatBehavior="Forever">
                      <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Image.Triggers>
          </Image>
          <Image x:Name="Bat1" Visibility="{DynamicResource HalloweenVisibility}" Canvas.Left="-200" Canvas.Top="50" Width="64" Stretch="Uniform" Opacity="0.95">
            <Image.RenderTransform><TranslateTransform X="0" Y="0"/></Image.RenderTransform>
          </Image>
          <Image x:Name="Bat2" Visibility="{DynamicResource HalloweenVisibility}" Canvas.Left="-200" Canvas.Top="110" Width="44" Stretch="Uniform" Opacity="0.85">
            <Image.RenderTransform><TranslateTransform X="0" Y="0"/></Image.RenderTransform>
          </Image>
          <Image x:Name="GhostBack" Visibility="{DynamicResource HalloweenVisibility}" Canvas.Left="150" Canvas.Top="60" Width="56" Stretch="Uniform" Opacity="0.9">
            <Image.RenderTransform><TranslateTransform X="0" Y="0"/></Image.RenderTransform>
            <Image.Triggers>
              <EventTrigger RoutedEvent="Image.Loaded">
                <BeginStoryboard>
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="-16" To="14" Duration="0:0:7.3" AutoReverse="True" RepeatBehavior="Forever">
                      <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" From="-8" To="10" Duration="0:0:3.2" AutoReverse="True" RepeatBehavior="Forever">
                      <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Image.Triggers>
          </Image>
          <Ellipse x:Name="EyeL" Visibility="{DynamicResource HalloweenVisibility}" Canvas.Left="940" Canvas.Top="60" Width="9" Height="11" Fill="#FF8C2B" Opacity="0.9" IsHitTestVisible="False">
            <Ellipse.RenderTransform>
              <TransformGroup>
                <TranslateTransform x:Name="EyeLMove" X="0" Y="0"/>
                <ScaleTransform x:Name="EyeLBlink" CenterX="4.5" CenterY="5.5" ScaleX="1" ScaleY="1"/>
              </TransformGroup>
            </Ellipse.RenderTransform>
            <Ellipse.Effect><DropShadowEffect Color="#FF8C2B" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/></Ellipse.Effect>
          </Ellipse>
          <Ellipse x:Name="EyeR" Visibility="{DynamicResource HalloweenVisibility}" Canvas.Left="962" Canvas.Top="60" Width="9" Height="11" Fill="#FF8C2B" Opacity="0.9" IsHitTestVisible="False">
            <Ellipse.RenderTransform>
              <TransformGroup>
                <TranslateTransform x:Name="EyeRMove" X="0" Y="0"/>
                <ScaleTransform x:Name="EyeRBlink" CenterX="4.5" CenterY="5.5" ScaleX="1" ScaleY="1"/>
              </TransformGroup>
            </Ellipse.RenderTransform>
            <Ellipse.Effect><DropShadowEffect Color="#FF8C2B" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/></Ellipse.Effect>
          </Ellipse>
        </Canvas>
      </Viewbox>
      <Canvas IsHitTestVisible="False" Visibility="{DynamicResource HalloweenVisibility}" Grid.RowSpan="3" VerticalAlignment="Top" HorizontalAlignment="Right" Width="120" Height="150" Margin="0,0,40,0" Panel.ZIndex="100">
        <Line x:Name="WebLine" X1="60" Y1="0" X2="60" Y2="74" Stroke="#3A2B52" StrokeThickness="1.5"/>
        <Path x:Name="Spider" Data="{StaticResource IcoSpider}" Fill="Transparent" Stroke="{StaticResource Text2}" StrokeThickness="1.6" Width="26" Height="26" Stretch="Uniform" Canvas.Left="47" Canvas.Top="70">
          <Path.RenderTransform>
            <TransformGroup>
              <RotateTransform CenterX="13" CenterY="2" Angle="0"/>
              <TranslateTransform x:Name="SpiderDrag" X="0" Y="0"/>
              <ScaleTransform x:Name="SpiderStretch" CenterX="13" CenterY="13" ScaleX="1" ScaleY="1"/>
            </TransformGroup>
          </Path.RenderTransform>
          <Path.Triggers>
            <EventTrigger RoutedEvent="Path.Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                  <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[0].Angle" From="-16" To="16" Duration="0:0:2.1" AutoReverse="True" RepeatBehavior="Forever"/>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </Path.Triggers>
        </Path>
      </Canvas>

      <Border VerticalAlignment="Bottom" Height="1" Margin="0,0,0,0" IsHitTestVisible="False">
        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00D4AF37" Offset="0"/><GradientStop Color="#55D4AF37" Offset="0.2"/><GradientStop Color="#22D4AF37" Offset="0.7"/><GradientStop Color="#00D4AF37" Offset="1"/></LinearGradientBrush></Border.Background>
      </Border>

      <Grid Margin="30,0,10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,18,0,0">
          <Grid Width="30" Height="30" VerticalAlignment="Top" Margin="0,11,10,0">
            <Path Data="{StaticResource IcoFedora}" Fill="{StaticResource Gold}" Stretch="Uniform" Visibility="{DynamicResource MafiaVisibility}"/>
            <Path Data="{StaticResource IcoPumpkin}" Fill="{StaticResource Gold}" Stretch="Uniform" Visibility="{DynamicResource HalloweenVisibility}"/>
          </Grid>
          <StackPanel VerticalAlignment="Top" Margin="0,3,0,0">
            <TextBlock Text="Idle Mafia" FontFamily="{StaticResource Deco}" FontSize="23" Foreground="{StaticResource Gold}"/>
            <TextBlock x:Name="HauntedLabel" Text="HAUNTED EDITION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BloodRed}" Visibility="{DynamicResource HalloweenVisibility}" Margin="1,-2,0,0">
              <TextBlock.Triggers>
                <EventTrigger RoutedEvent="TextBlock.Loaded">
                  <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                      <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                        <DiscreteDoubleKeyFrame KeyTime="0:0:1.7" Value="0.35"/>
                        <DiscreteDoubleKeyFrame KeyTime="0:0:1.9" Value="1"/>
                        <DiscreteDoubleKeyFrame KeyTime="0:0:3.4" Value="0.5"/>
                        <DiscreteDoubleKeyFrame KeyTime="0:0:3.6" Value="1"/>
                      </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </TextBlock.Triggers>
            </TextBlock>
          </StackPanel>
          <Border Width="1" Height="24" Background="{StaticResource Line}" Margin="24,8,24,0" VerticalAlignment="Top"/>
          <RadioButton x:Name="RailOverview" Style="{StaticResource TopTab}" Tag="Home" IsChecked="True" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <RadioButton x:Name="RailJobs" Style="{StaticResource TopTab}" Tag="Tasks" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <RadioButton x:Name="RailSettings" Style="{StaticResource TopTab}" Tag="Settings" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </StackPanel>
        <TextBlock x:Name="PageTitle" Visibility="Collapsed"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,10,0,0">

          <Button x:Name="BtnPresets" Style="{StaticResource Btn}" Padding="14,10" Margin="0,4,10,0" VerticalAlignment="Top"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Save your switches as a preset, switch between presets, share one">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource Icon}" Data="{StaticResource IcoSliders}" Width="16" Height="16" VerticalAlignment="Center"/>
              <TextBlock x:Name="PresetNow" Text="Presets" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" MaxWidth="170" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Button>

          <Button x:Name="BtnDiscordTop" Style="{StaticResource PrimaryBtn}" Background="#5865F2" Padding="14,10" Margin="0,4,10,0"
                  VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Questions, problems or ideas? Ask in the Discord">
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource IcoDiscord}" Fill="White" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
              <TextBlock Text="Discord" Margin="8,0,0,0" FontWeight="Bold" FontSize="13.5" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Border x:Name="StatePill" CornerRadius="17" Background="{StaticResource Panel}" Padding="13,8" Margin="0,4,10,0"
                  VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="StateDot" Width="9" Height="9" Fill="{StaticResource Text3}" VerticalAlignment="Center"/>
              <TextBlock x:Name="StateText" Text="Stopped" Margin="9,0,0,0" FontWeight="SemiBold" FontSize="13"
                         Foreground="{StaticResource Text2}" MaxWidth="330"/>
            </StackPanel>
          </Border>
          <Button x:Name="BtnStart" Style="{StaticResource PrimaryBtn}" Padding="18,11" Margin="0,4,16,0" MinWidth="132"
                  VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel Orientation="Horizontal">
              <Path x:Name="BtnStartIcon" Data="{StaticResource IcoPlay}" Fill="{StaticResource OnGold}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
              <TextBlock x:Name="BtnStartText" Text="Start" Margin="9,0,0,0" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource OnGold}"/>
              <Border CornerRadius="5" Background="#22000000" Padding="5,1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="F6" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OnGold}"/>
              </Border>
            </StackPanel>
          </Button>
          <Button x:Name="BtnMin" Style="{StaticResource WinBtn}" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize">
            <Path Data="M0,0 L10,0" Stroke="{StaticResource Text2}" StrokeThickness="1.2"/>
          </Button>
          <Button x:Name="BtnClose" Style="{StaticResource CloseBtn}" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close">
            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource Text}" StrokeThickness="1.2"/>
          </Button>
        </StackPanel>
      </Grid>

      <Border x:Name="NowStrip" Grid.Row="1" Margin="30,0,30,14" CornerRadius="12" Background="{StaticResource Panel}"
              BorderBrush="{StaticResource LineSoft}" BorderThickness="1" Padding="14,10" Visibility="Collapsed">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Grid Width="16" Height="16" VerticalAlignment="Center">
              <Ellipse x:Name="NowGlow" Width="16" Height="16" Fill="{StaticResource Gold}" Opacity="0.25"/>
              <Ellipse Width="8" Height="8" Fill="{StaticResource Gold}"/>
            </Grid>
            <TextBlock x:Name="NowText" Margin="10,0,0,0" FontSize="13.5" Foreground="{StaticResource Text2}" VerticalAlignment="Center"/>
          </StackPanel>

          <TextBlock x:Name="StuckText" Margin="26,6,0,0" FontSize="13" Foreground="{StaticResource Red}" TextWrapping="Wrap" Visibility="Collapsed"/>
          <TextBlock x:Name="FullBarsText" Margin="26,6,0,0" FontSize="12.5" Foreground="{StaticResource Text3}" TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>
      </Border>

      <Border x:Name="OcrBanner" Grid.Row="1" Margin="30,0,30,14" CornerRadius="12" Background="#2B1917" BorderBrush="#66C84B3F"
              BorderThickness="1" Padding="16,13" Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Path Style="{StaticResource Icon}" Data="{StaticResource IcoWarn}" Stroke="{StaticResource Red}" VerticalAlignment="Top" Margin="0,0,14,0"/>
          <StackPanel Grid.Column="1">
            <TextBlock x:Name="OcrTitle" Text="The bot can't read the game yet" FontWeight="Bold" FontSize="15"/>
            <TextBox x:Name="OcrText" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0"
                     Margin="-2,4,0,0" FontSize="13" Foreground="{StaticResource Text2}" CaretBrush="{StaticResource Text}"
                     SelectionBrush="{StaticResource Gold}"/>
          </StackPanel>
          <Button x:Name="BtnOcrSettings" Grid.Column="2" Style="{StaticResource Btn}" VerticalAlignment="Top" Margin="16,0,0,0">
            <TextBlock Text="Open language settings" FontWeight="SemiBold"/>
          </Button>
        </Grid>
      </Border>

      <Grid Grid.Row="2">

        <ScrollViewer x:Name="PageOverview" VerticalScrollBarVisibility="Auto">
          <Grid x:Name="HomeGrid" Margin="30,0,30,16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="CheckCard" Grid.Row="0" Style="{StaticResource Card}" BorderBrush="#66D4AF37" Padding="20,16" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource GoldSoft}" VerticalAlignment="Center">
                  <Path Style="{StaticResource Icon}" Data="{StaticResource IcoScan}" Stroke="{StaticResource Gold}" Width="20" Height="20"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                  <TextBlock x:Name="CheckCardTitle" Text="Set the bot up for your account?" FontWeight="Bold" FontSize="15"/>
                  <TextBlock x:Name="CheckCardText" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="BtnCheckLater" Style="{StaticResource GhostBtn}" Margin="0,0,8,0">
                    <TextBlock Text="Not now" FontWeight="SemiBold" Foreground="{StaticResource Text2}"/>
                  </Button>
                  <Button x:Name="BtnCheckNow" Style="{StaticResource PrimaryBtn}" Padding="18,10">
                    <TextBlock Text="Check my game" FontWeight="Bold" Foreground="{StaticResource OnGold}"/>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Row="1" CornerRadius="14" BorderBrush="#3A3119" BorderThickness="1" Margin="0,0,0,14" ClipToBounds="True">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#2A2213" Offset="0"/>
                  <GradientStop Color="#17161A" Offset="0.5"/>
                  <GradientStop Color="#0F0F12" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <Grid x:Name="HeroScene">

                <Ellipse Width="420" Height="420" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-202,152,0" IsHitTestVisible="False">
                  <Ellipse.Fill>
                    <RadialGradientBrush>
                      <GradientStop Color="#33F3DFA2" Offset="0"/>
                      <GradientStop Color="#10F3DFA2" Offset="0.45"/>
                      <GradientStop Color="#00F3DFA2" Offset="1"/>
                    </RadialGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="64" Height="64" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-24,330,0" IsHitTestVisible="False" Opacity="0.85">
                  <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.35,0.35">
                      <GradientStop Color="#F6E9C0" Offset="0"/>
                      <GradientStop Color="#D9C48A" Offset="0.8"/>
                      <GradientStop Color="#B9A46C" Offset="1"/>
                    </RadialGradientBrush>
                  </Ellipse.Fill>
                  <Ellipse.Effect><DropShadowEffect Color="#F3DFA2" BlurRadius="40" ShadowDepth="0" Opacity="0.6"/></Ellipse.Effect>
                </Ellipse>

                <Viewbox Stretch="UniformToFill" VerticalAlignment="Bottom" Height="190" IsHitTestVisible="False">
                  <Canvas Width="1600" Height="240">
                    <Path Data="{StaticResource SkylineFar}" Fill="{StaticResource SkylineFarFill}" Visibility="{DynamicResource MafiaVisibility}"/>
                    <Path Data="{StaticResource SkylineNear}" Fill="{StaticResource SkylineNearFill}" Visibility="{DynamicResource MafiaVisibility}"/>
                    <Path Data="{StaticResource SkylineWindows}" Fill="{StaticResource SkylineWinFill}" Opacity="0.75" Visibility="{DynamicResource MafiaVisibility}"/>
                    <Image x:Name="HImgBack" Visibility="{DynamicResource HalloweenVisibility}" Canvas.Left="0" Canvas.Top="0" Width="1600" Height="240" Stretch="Fill"/>
                    <Image x:Name="HImgMid" Visibility="{DynamicResource HalloweenVisibility}" Canvas.Left="310" Canvas.Top="0" Width="1056" Height="240" Stretch="Fill"/>
                    <Image x:Name="GhostHero" Visibility="{DynamicResource HalloweenVisibility}" Canvas.Left="1415" Canvas.Top="150" Width="52" Stretch="Uniform" Opacity="0.9">
                      <Image.RenderTransform><TranslateTransform X="0" Y="0"/></Image.RenderTransform>
                      <Image.Triggers>
                        <EventTrigger RoutedEvent="Image.Loaded">
                          <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                              <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" From="-10" To="8" Duration="0:0:2.7" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                              </DoubleAnimation>
                              <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="-7" To="9" Duration="0:0:5.9" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                              </DoubleAnimation>
                            </Storyboard>
                          </BeginStoryboard>
                        </EventTrigger>
                      </Image.Triggers>
                    </Image>
                    <Image x:Name="Bat3" Visibility="{DynamicResource HalloweenVisibility}" Canvas.Left="-200" Canvas.Top="40" Width="72" Stretch="Uniform" Opacity="0.9">
                      <Image.RenderTransform><TranslateTransform X="0" Y="0"/></Image.RenderTransform>
                    </Image>
                  </Canvas>
                </Viewbox>
                <Border VerticalAlignment="Bottom" Height="110" IsHitTestVisible="False">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Color="#000C0C0E" Offset="0"/>
                      <GradientStop Color="#D90C0C0E" Offset="0.55"/>
                      <GradientStop Color="#F00C0C0E" Offset="1"/>
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
                <StackPanel Margin="24,20,20,16">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="64" Height="64" CornerRadius="14" BorderBrush="{StaticResource Gold}" BorderThickness="1.5">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                          <GradientStop Color="{StaticResource LvlA}" Offset="0"/>
                          <GradientStop Color="{StaticResource LvlB}" Offset="1"/>
                        </LinearGradientBrush>
                      </Border.Background>
                      <Border.Effect><DropShadowEffect Color="{StaticResource LvlGlow}" BlurRadius="18" ShadowDepth="0" Opacity="0.45"/></Border.Effect>
                      <Grid>
                        <Path Data="{StaticResource IcoPumpkin}" Fill="{StaticResource Gold}" Width="15" Height="15" Stretch="Uniform"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" Opacity="0.9"
                              Visibility="{DynamicResource HalloweenVisibility}"/>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock x:Name="LevelText" Text="?" FontFamily="{StaticResource Deco}" FontSize="26"
                                     Foreground="{StaticResource Gold}" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                          <TextBlock Text="LEVEL" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource LvlSub}" HorizontalAlignment="Center" Margin="0,-3,0,0"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0,28,0" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PlayerName" Text="Waiting for Roblox" FontFamily="{StaticResource Deco}" FontSize="30"/>
                        <TextBlock x:Name="PlayerFamily" Text="" FontFamily="{StaticResource Serif}" Foreground="{StaticResource Gold}" FontSize="16"
                                   Margin="14,11,0,0"/>
                      </StackPanel>
                      <Grid Margin="0,10,0,0" Height="24">
                        <Border CornerRadius="7" Background="{StaticResource Track}"/>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="XpA" Width="0*"/>
                            <ColumnDefinition x:Name="XpB" Width="1*"/>
                          </Grid.ColumnDefinitions>
                          <Border CornerRadius="7" Background="{StaticResource Xp}"/>
                        </Grid>
                        <TextBlock x:Name="XpText" Text="" FontWeight="Bold" FontSize="12.5" Margin="11,0" VerticalAlignment="Center"/>
                      </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                      <TextBlock x:Name="CashText" Text="-" FontFamily="{StaticResource Deco}" FontSize="38" Foreground="{StaticResource Green}" HorizontalAlignment="Right">
                        <TextBlock.Effect><DropShadowEffect Color="#7EBE5A" BlurRadius="16" ShadowDepth="0" Opacity="0.35"/></TextBlock.Effect>
                      </TextBlock>
                      <TextBlock x:Name="BankText" Text="" FontSize="12.5" Foreground="{StaticResource Text2}" HorizontalAlignment="Right" Margin="0,-2,0,0"/>
                    </StackPanel>
                  </Grid>
                  <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="22"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="22"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <Grid>
                        <TextBlock x:Name="EnergyText" Text="-" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Energy" FontSize="12" Foreground="{StaticResource Energy}" HorizontalAlignment="Right"/>
                      </Grid>
                      <Grid Height="8" Margin="0,7,0,0">
                        <Border CornerRadius="4" Background="#0B0B0C"/>
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition x:Name="EnergyA" Width="0*"/><ColumnDefinition x:Name="EnergyB" Width="1*"/></Grid.ColumnDefinitions>
                          <Border CornerRadius="4" Background="{StaticResource Energy}">
                            <Border.Effect><DropShadowEffect Color="#E08C32" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/></Border.Effect>
                          </Border>
                        </Grid>
                      </Grid>
                      <TextBlock x:Name="EnergyTick" Text="" FontSize="11.5" Foreground="{StaticResource Text3}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <Grid>
                        <TextBlock x:Name="StaminaText" Text="-" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Stamina" FontSize="12" Foreground="#6FA6D2" HorizontalAlignment="Right"/>
                      </Grid>
                      <Grid Height="8" Margin="0,7,0,0">
                        <Border CornerRadius="4" Background="#0B0B0C"/>
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition x:Name="StaminaA" Width="0*"/><ColumnDefinition x:Name="StaminaB" Width="1*"/></Grid.ColumnDefinitions>
                          <Border CornerRadius="4" Background="{StaticResource Stamina}">
                            <Border.Effect><DropShadowEffect Color="#5B8FB9" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/></Border.Effect>
                          </Border>
                        </Grid>
                      </Grid>
                      <TextBlock x:Name="StaminaTick" Text="" FontSize="11.5" Foreground="{StaticResource Text3}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                      <Grid>
                        <TextBlock x:Name="HealthText" Text="-" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Health" FontSize="12" Foreground="#D2645A" HorizontalAlignment="Right"/>
                      </Grid>
                      <Grid Height="8" Margin="0,7,0,0">
                        <Border CornerRadius="4" Background="#0B0B0C"/>
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition x:Name="HealthA" Width="0*"/><ColumnDefinition x:Name="HealthB" Width="1*"/></Grid.ColumnDefinitions>
                          <Border CornerRadius="4" Background="{StaticResource Health}">
                            <Border.Effect><DropShadowEffect Color="#BA4A3E" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/></Border.Effect>
                          </Border>
                        </Grid>
                      </Grid>
                      <TextBlock x:Name="PointsText" Text="" FontSize="11.5" Foreground="{StaticResource Gold}" Margin="0,5,0,0"/>
                    </StackPanel>
                  </Grid>

                  <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid Width="18" Height="18" VerticalAlignment="Center">
                      <Ellipse x:Name="HomeNowGlow" Width="18" Height="18" Fill="{StaticResource Text3}" Opacity="0.2"/>
                      <Ellipse x:Name="HomeNowDot" Width="8" Height="8" Fill="{StaticResource Text3}"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                      <TextBlock x:Name="HomeNowTitle" Text="Stopped" FontFamily="{StaticResource Deco}" FontSize="20"/>
                      <TextBlock x:Name="HomeNow" Text="Press Start and the bot plays for you." FontSize="13" Foreground="{StaticResource Text2}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button x:Name="BtnStartBig" Grid.Column="2" Style="{StaticResource PrimaryBtn}" Padding="28,13" MinWidth="170" VerticalAlignment="Center">
                      <Button.Effect><DropShadowEffect Color="#D4AF37" BlurRadius="22" ShadowDepth="0" Opacity="0.45"/></Button.Effect>
                      <StackPanel Orientation="Horizontal">
                        <Path x:Name="BtnStartBigIcon" Data="{StaticResource IcoPlay}" Fill="{StaticResource OnGold}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BtnStartBigText" Text="Start" Margin="10,0,0,0" FontWeight="Bold" FontSize="16" Foreground="{StaticResource OnGold}"/>
                        <Border CornerRadius="5" Background="#22000000" Padding="5,1" Margin="12,0,0,0" VerticalAlignment="Center">
                          <TextBlock Text="F6" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OnGold}"/>
                        </Border>
                      </StackPanel>
                    </Button>
                  </Grid>
                </StackPanel>
              </Grid>
            </Border>

            <Grid Grid.Row="3">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

              <UniformGrid Columns="6" Margin="0,0,-10,14">
                <ContentControl Style="{StaticResource StatTile}" Tag="{StaticResource IcoJobs}">
                  <ContentControl.Resources>
                    <SolidColorBrush x:Key="TileAccent" Color="#E8953C"/>
                    <PathGeometry x:Key="Blood1" Figures="M4,0 L10,0 C9,8 9.2,10 8.6,14 C8,20 8.6,24 7,27 C5.4,24 6,20 5.4,14 C4.8,10 5,8 4,0 Z"/>
                    <PathGeometry x:Key="Blood2" Figures="M2,0 L12,0 C12,8 13,12 13,16 C13,23 10,28 7,28 C4,28 1,23 1,16 C1,12 2,8 2,0 Z"/>
                    <PathGeometry x:Key="Blood3" Figures="M5,0 L9,0 L8.2,18 L7,28 L5.8,18 Z"/>
                  </ContentControl.Resources>
                  <StackPanel><TextBlock x:Name="TotJobs" Text="0" FontFamily="{StaticResource Deco}" FontSize="24"/>
                    <TextBlock Text="jobs" FontSize="12" Foreground="{StaticResource Text2}"/></StackPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource StatTile}" Tag="{StaticResource IcoHeist}">
                  <ContentControl.Resources>
                    <SolidColorBrush x:Key="TileAccent" Color="#B08AE6"/>
                    <PathGeometry x:Key="Blood1" Figures="M3,0 L11,0 L10,11 L12.5,21 L9.5,19 L7,26 L4.5,19 L1.5,21 L4,11 Z"/>
                    <PathGeometry x:Key="Blood2" Figures="M6.4,0 L7.6,0 L7.6,24 L6.4,24 Z M4,4 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 M4.5,11.5 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 M5,18.5 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0"/>
                    <PathGeometry x:Key="Blood3" Figures="M4,0 L10,0 C9,8 9.2,10 8.6,14 C8,20 8.6,24 7,27 C5.4,24 6,20 5.4,14 C4.8,10 5,8 4,0 Z"/>
                  </ContentControl.Resources>
                  <StackPanel><TextBlock x:Name="TotHelps" Text="0" FontFamily="{StaticResource Deco}" FontSize="24"/>
                    <TextBlock Text="heist helps" FontSize="12" Foreground="{StaticResource Text2}"/></StackPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource StatTile}" Tag="{StaticResource IcoCrown}">
                  <ContentControl.Resources>
                    <SolidColorBrush x:Key="TileAccent" Color="#5FA0D6"/>
                    <PathGeometry x:Key="Blood1" Figures="M2,0 L12,0 C12,8 13,12 13,16 C13,23 10,28 7,28 C4,28 1,23 1,16 C1,12 2,8 2,0 Z"/>
                    <PathGeometry x:Key="Blood2" Figures="M0,0 L14,0 L14,4 L11,4 L11,14 C11,18 10.4,20 9.6,20 C8.8,20 8.4,18 8.4,14 L8.4,4 L5.6,4 L5.6,10 C5.6,13 5.2,14.5 4.6,14.5 C4,14.5 3.6,13 3.6,10 L3.6,4 L0,4 Z"/>
                    <PathGeometry x:Key="Blood3" Figures="M6.4,0 L7.6,0 L7.6,24 L6.4,24 Z M4,4 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 M4.5,11.5 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 M5,18.5 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0"/>
                  </ContentControl.Resources>
                  <StackPanel><TextBlock x:Name="TotBoss" Text="0" FontFamily="{StaticResource Deco}" FontSize="24"/>
                    <TextBlock Text="boss hits" FontSize="12" Foreground="{StaticResource Text2}"/></StackPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource StatTile}" Tag="{StaticResource IcoSwords}">
                  <ContentControl.Resources>
                    <SolidColorBrush x:Key="TileAccent" Color="#E05A4C"/>
                    <PathGeometry x:Key="Blood1" Figures="M0,0 L14,0 L14,4 L11,4 L11,14 C11,18 10.4,20 9.6,20 C8.8,20 8.4,18 8.4,14 L8.4,4 L5.6,4 L5.6,10 C5.6,13 5.2,14.5 4.6,14.5 C4,14.5 3.6,13 3.6,10 L3.6,4 L0,4 Z"/>
                    <PathGeometry x:Key="Blood2" Figures="M3,0 L11,0 L10,11 L12.5,21 L9.5,19 L7,26 L4.5,19 L1.5,21 L4,11 Z"/>
                    <PathGeometry x:Key="Blood3" Figures="M2,0 L12,0 C12,8 13,12 13,16 C13,23 10,28 7,28 C4,28 1,23 1,16 C1,12 2,8 2,0 Z"/>
                  </ContentControl.Resources>
                  <StackPanel><TextBlock x:Name="TotFights" Text="0" FontFamily="{StaticResource Deco}" FontSize="24"/>
                    <TextBlock x:Name="TotFightsSub" Text="fights" FontSize="12" Foreground="{StaticResource Text2}"/></StackPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource StatTile}" Tag="{StaticResource IcoBank}">
                  <ContentControl.Resources>
                    <SolidColorBrush x:Key="TileAccent" Color="#86C95F"/>
                    <PathGeometry x:Key="Blood1" Figures="M5,0 L9,0 L8.2,18 L7,28 L5.8,18 Z"/>
                    <PathGeometry x:Key="Blood2" Figures="M4,0 L10,0 C9,8 9.2,10 8.6,14 C8,20 8.6,24 7,27 C5.4,24 6,20 5.4,14 C4.8,10 5,8 4,0 Z"/>
                    <PathGeometry x:Key="Blood3" Figures="M0,0 L14,0 L14,4 L11,4 L11,14 C11,18 10.4,20 9.6,20 C8.8,20 8.4,18 8.4,14 L8.4,4 L5.6,4 L5.6,10 C5.6,13 5.2,14.5 4.6,14.5 C4,14.5 3.6,13 3.6,10 L3.6,4 L0,4 Z"/>
                  </ContentControl.Resources>
                  <StackPanel><TextBlock x:Name="TotDeposits" Text="0" FontFamily="{StaticResource Deco}" FontSize="24"/>
                    <TextBlock Text="deposits" FontSize="12" Foreground="{StaticResource Text2}"/></StackPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource StatTile}" Tag="{StaticResource IcoGift}">
                  <ContentControl.Resources>
                    <SolidColorBrush x:Key="TileAccent" Color="#E2BD45"/>
                    <PathGeometry x:Key="Blood1" Figures="M6.4,0 L7.6,0 L7.6,24 L6.4,24 Z M4,4 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 M4.5,11.5 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 M5,18.5 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0"/>
                    <PathGeometry x:Key="Blood2" Figures="M5,0 L9,0 L8.2,18 L7,28 L5.8,18 Z"/>
                    <PathGeometry x:Key="Blood3" Figures="M3,0 L11,0 L10,11 L12.5,21 L9.5,19 L7,26 L4.5,19 L1.5,21 L4,11 Z"/>
                  </ContentControl.Resources>
                  <StackPanel><TextBlock x:Name="TotRewards" Text="0" FontFamily="{StaticResource Deco}" FontSize="24"/>
                    <TextBlock Text="rewards" FontSize="12" Foreground="{StaticResource Text2}"/></StackPanel>
                </ContentControl>
              </UniformGrid>

              <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0,14,0,6" Background="#B31A1A1C">
                <DockPanel>
                  <Grid DockPanel.Dock="Top" Margin="20,0,20,0">
                    <TextBlock Text="Activity" FontFamily="{StaticResource Deco}" FontSize="17"/>
                    <TextBlock x:Name="FeedCount" Text="" FontSize="12" Foreground="{StaticResource Text3}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  </Grid>
                  <TextBlock x:Name="FeedEmpty" DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="20,12,20,4"
                             Text="Nothing yet. Press Start and everything the bot does shows up here."/>
                  <ScrollViewer x:Name="FeedScroll" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                  <ItemsControl x:Name="Feed" Margin="0,0,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#222225" BorderThickness="0,1,0,0" Padding="20,9,20,9">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="30"/>
                              <ColumnDefinition Width="72"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="{Binding Icon}" Stroke="{Binding Color}" StrokeThickness="1.8" Width="15" Height="15" Stretch="Uniform"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Who}" Foreground="{Binding Color}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" TextTrimming="None" FontSize="13" Foreground="#D9D3C1" Margin="0,0,14,0"/>
                            <TextBlock Grid.Column="3" Text="{Binding Time}" Foreground="#6F6B61" FontSize="12" VerticalAlignment="Top" Margin="0,1,0,0"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </Border>
            </Grid>

            <StackPanel x:Name="HomeHidden" Visibility="Collapsed">
              <Button x:Name="BtnReportHome"><TextBlock x:Name="ReportHomeText"/></Button>
            </StackPanel>
          </Grid>
        </ScrollViewer>

        <ScrollViewer x:Name="PageJobs" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">

          <StackPanel Margin="30,8,18,16">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
              <HeaderedContentControl Style="{StaticResource TaskGroup}" Header="Energy">
                <HeaderedContentControl.Resources><SolidColorBrush x:Key="TileAccent" Color="#E8953C"/></HeaderedContentControl.Resources>
                <UniformGrid Columns="2" Rows="1">
                  <CheckBox x:Name="sw_Jobs" Style="{StaticResource TaskTile}" Tag="{StaticResource IcoJobs}" Uid="1" Content="Do jobs" ToolTip="Each job costs energy and gives cash, XP and mastery."/>
                  <CheckBox x:Name="sw_Heists" Style="{StaticResource TaskTile}" Tag="{StaticResource IcoHeist}" Uid="1" Content="Help heists" ToolTip="Your family's first, then only the ones worth more XP."/>
                </UniformGrid>
              </HeaderedContentControl>
              <HeaderedContentControl Grid.Column="1" Style="{StaticResource TaskGroup}" Header="Stamina">
                <HeaderedContentControl.Resources><SolidColorBrush x:Key="TileAccent" Color="#5FA0D6"/></HeaderedContentControl.Resources>
                <UniformGrid Columns="3" Rows="1">
                  <CheckBox x:Name="sw_Bosses" Style="{StaticResource TaskTile}" Tag="{StaticResource IcoCrown}" Uid="1" Content="Fight bosses" ToolTip="Climbs the stages, again after the daily reset."/>
                  <CheckBox x:Name="sw_Fights" Style="{StaticResource TaskTile}" Tag="{StaticResource IcoSwords}" Uid="1" Content="Attack players" ToolTip="Lowest level first, each player once, then a new list."/>
                  <CheckBox x:Name="sw_WhaleHunt" Style="{StaticResource TaskTile}" Tag="{StaticResource IcoFlag}" Uid="1" Content="Hit big wins again" ToolTip="Banks, then hits a player again after a big win."/>
                </UniformGrid>
              </HeaderedContentControl>
              <HeaderedContentControl Grid.Column="2" Style="{StaticResource TaskGroup}" Header="Crew">
                <HeaderedContentControl.Resources><SolidColorBrush x:Key="TileAccent" Color="#E8769F"/></HeaderedContentControl.Resources>
                <UniformGrid Columns="3" Rows="1">
                  <CheckBox x:Name="sw_CrewFill" Style="{StaticResource TaskTile}" Tag="{StaticResource IcoCrew}" Uid="1" Content="Hire into empty slots" ToolTip="With the hire you pick, or a cheaper one."/>
                  <CheckBox x:Name="tile_Reroll" Style="{StaticResource TaskTile}" Tag="{StaticResource IcoReroll}" Uid="1" Content="Reroll the worst" ToolTip="Dismisses your worst henchman and hires again, until the crew is the best the hire can reach."/>
                  <CheckBox x:Name="sw_TrainCrew" Style="{StaticResource TaskTile}" Tag="{StaticResource IcoStar}" Uid="1" Content="Train the crew" ToolTip="Epic and up. Costs cash and time."/>
                </UniformGrid>
              </HeaderedContentControl>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="4*"/><ColumnDefinition Width="5*"/></Grid.ColumnDefinitions>
              <HeaderedContentControl Style="{StaticResource TaskGroup}" Header="Family">
                <HeaderedContentControl.Resources><SolidColorBrush x:Key="TileAccent" Color="#4FC2B1"/></HeaderedContentControl.Resources>
                <UniformGrid Columns="5" Rows="1">
                  <CheckBox x:Name="sw_FamilyWatch" Style="{StaticResource TaskTile}" Tag="{StaticResource IcoFamily}" Uid="1" Content="Watch my family" ToolTip="Reads the family pages every 3 hours. It only reads."/>
                  <CheckBox x:Name="sw_GameStats" Style="{StaticResource TaskTile}" Tag="{StaticResource IcoChart}" Content="Read game stats" ToolTip="Opens the menu and reads YOUR STATS every 3 hours. It only reads."/>
                  <CheckBox x:Name="sw_Takedown" Style="{StaticResource TaskTile}" Tag="{StaticResource IcoTarget}" Uid="1" Content="Takedown attacks" ToolTip="The family's weekly boss, free attacks only. It never uses tickets."/>
                  <CheckBox x:Name="sw_GiveStamina" Style="{StaticResource TaskTile}" Tag="{StaticResource IcoBolt}" Uid="1" Content="Stamina to perks" ToolTip="Spare stamina to your family's stamina perks."/>
                  <CheckBox x:Name="sw_DefendTerritory" Style="{StaticResource TaskTile}" Tag="{StaticResource IcoShield}" Uid="1" Content="Defend districts" ToolTip="When one is attacked: your whole crew to it, recalled after. With your family's link it also reads each district's garrison every 3 hours."/>
                </UniformGrid>
              </HeaderedContentControl>
              <HeaderedContentControl Grid.Column="1" Style="{StaticResource TaskGroup}" Header="Cash">
                <HeaderedContentControl.Resources><SolidColorBrush x:Key="TileAccent" Color="#86C95F"/></HeaderedContentControl.Resources>
                <UniformGrid Columns="5" Rows="1">
                  <CheckBox x:Name="sw_Properties" Style="{StaticResource TaskTile}" Tag="{StaticResource IcoHome}" Uid="1" Content="Buy properties" ToolTip="The best you can afford, swapping out your weakest when a better one is affordable."/>
                  <CheckBox x:Name="sw_Bank" Style="{StaticResource TaskTile}" Tag="{StaticResource IcoBank}" Content="Bank my cash" ToolTip="After every round, so other players can't take it."/>
                  <CheckBox x:Name="sw_SafehouseUpgrade" Style="{StaticResource TaskTile}" Tag="{StaticResource IcoLock}" Uid="1" Content="Upgrade safehouse" ToolTip="With the cash left after the next property."/>
                  <CheckBox x:Name="sw_SpendPoints" Style="{StaticResource TaskTile}" Tag="{StaticResource IcoChart}" Uid="1" Content="Spend skill points" ToolTip="On the stat you pick."/>
                  <CheckBox x:Name="sw_ShopBuy" Style="{StaticResource TaskTile}" Tag="{StaticResource IcoBag}" Uid="1" Content="Buy from the shop" ToolTip="Everything you can pay for with cash. Never Robux."/>
                </UniformGrid>
              </HeaderedContentControl>
            </Grid>
            <HeaderedContentControl Style="{StaticResource TaskGroup}" Header="Rewards">
              <HeaderedContentControl.Resources><SolidColorBrush x:Key="TileAccent" Color="#B08AE6"/></HeaderedContentControl.Resources>
              <UniformGrid Columns="7" Rows="1">
                <CheckBox x:Name="sw_Playtime" Style="{StaticResource TaskTile}" Tag="{StaticResource IcoClock}" Content="Playtime rewards" ToolTip="At 5, 15, 30, 60 and 120 minutes a day."/>
                <CheckBox x:Name="sw_Contracts" Style="{StaticResource TaskTile}" Tag="{StaticResource IcoLog}" Content="Contract tasks" ToolTip="Daily and weekly."/>
                <CheckBox x:Name="sw_Operations" Style="{StaticResource TaskTile}" Tag="{StaticResource IcoHourglass}" Uid="1" Content="Operations" ToolTip="The most XP per hour in every free slot."/>
                <CheckBox x:Name="sw_Briefcases" Style="{StaticResource TaskTile}" Tag="{StaticResource IcoGift}" Content="Lucky Briefcases" ToolTip="Free picks only, never keys."/>
                <CheckBox x:Name="sw_Events" Style="{StaticResource TaskTile}" Tag="{StaticResource IcoCalendar}" Content="Use events" ToolTip="Plans around the game's events."/>
                <CheckBox x:Name="sw_EquipBest" Style="{StaticResource TaskTile}" Tag="{StaticResource IcoGear}" Content="Equip the best gear" ToolTip="Then the spare items go into the collection."/>
                <CheckBox x:Name="sw_Crates" Style="{StaticResource TaskTile}" Tag="{StaticResource IcoDownload}" Content="Open crates" ToolTip="All of the same crate at once, then the best gear on again."/>
              </UniformGrid>
            </HeaderedContentControl>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel Margin="30,8,18,16">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="4*"/><ColumnDefinition Width="5*"/></Grid.ColumnDefinitions>
              <HeaderedContentControl Style="{StaticResource TaskGroup}" Header="Your PC">
                <UniformGrid Columns="4" Rows="1" VerticalAlignment="Top">
                  <CheckBox x:Name="sw_WaitWhileBusy" Style="{StaticResource TaskTile}" Tag="{StaticResource IcoHourglass}" Content="Wait while I use the PC" ToolTip="It only takes the mouse once you've left the PC alone for 15 seconds."/>
                  <CheckBox x:Name="sw_GiveFocusBack" Style="{StaticResource TaskTile}" Tag="{StaticResource IcoMonitor}" Content="Give my window back" ToolTip="After each round."/>
                  <CheckBox x:Name="sw_Rejoin" Style="{StaticResource TaskTile}" Tag="{StaticResource IcoPlug}" Uid="1" Content="Rejoin after a disconnect" ToolTip="Presses Reconnect or starts the game again."/>
                  <CheckBox x:Name="sw_KeepAlive" Style="{StaticResource TaskTile}" Tag="{StaticResource IcoClock}" Content="Stay in the game" ToolTip="A click after 15 quiet minutes, so Roblox doesn't kick you at 20."/>
                </UniformGrid>
              </HeaderedContentControl>
              <HeaderedContentControl Grid.Column="1" Style="{StaticResource TaskGroup}" Header="Tools">
                <HeaderedContentControl.Resources><SolidColorBrush x:Key="TileAccent" Color="#D8C79A"/></HeaderedContentControl.Resources>
                <StackPanel>

                  <UniformGrid Rows="1">

                    <Button x:Name="BtnCheck" Style="{StaticResource ActionTile}" Tag="{StaticResource IcoScan}" Uid="1">
                      <TextBlock Text="Check my game" TextWrapping="Wrap"/>
                    </Button>
                    <Button x:Name="BtnReview" Style="{StaticResource ActionTile}" Tag="{StaticResource IcoChart}">
                      <TextBlock Text="See the last check" TextWrapping="Wrap"/>
                    </Button>

                    <Grid>
                      <Button x:Name="BtnUpdate" Style="{StaticResource ActionTile}" Tag="{StaticResource IcoDownload}">
                        <TextBlock x:Name="UpdateText" Text="Check for updates" TextWrapping="Wrap"/>
                      </Button>

                      <Border x:Name="UpdateNew" Visibility="Collapsed" IsHitTestVisible="False" Height="16" CornerRadius="8" Padding="7,0"
                              Background="{StaticResource Red}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,4,0">
                        <TextBlock Text="new" FontSize="10" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                      </Border>
                    </Grid>
                    <Button x:Name="BtnLog" Style="{StaticResource ActionTile}" Tag="{StaticResource IcoLog}">
                      <TextBlock Text="Open log" TextWrapping="Wrap"/>
                    </Button>
                    <Button x:Name="BtnProblems" Style="{StaticResource ActionTile}" Tag="{StaticResource IcoFolder}">
                      <TextBlock x:Name="ProblemsText" Text="Problems" TextWrapping="Wrap"/>
                    </Button>
                    <Button x:Name="BtnReport" Style="{StaticResource ActionTile}" Tag="{StaticResource IcoFlag}">
                      <TextBlock x:Name="ReportText" Text="Report a problem" TextWrapping="Wrap"/>
                    </Button>
                  </UniformGrid>
                  <Grid Margin="2,2,12,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Check my game" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text2}" Margin="0,0,12,0"/>
                    <TextBlock x:Name="CheckWhen" Grid.Column="1" Text="" FontSize="12.5" Foreground="{StaticResource Text3}" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="1" Text="Updates" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text2}" Margin="0,5,12,0"/>
                    <TextBlock x:Name="UpdateStatus" Grid.Row="1" Grid.Column="1" FontSize="12.5" Foreground="{StaticResource Text3}" TextWrapping="Wrap" Margin="0,5,0,0"
                               Text="Looks for a new version on the bot's GitHub page, only when you press the button. Your settings stay."/>
                  </Grid>
                </StackPanel>
              </HeaderedContentControl>
            </Grid>
            <HeaderedContentControl Style="{StaticResource TaskGroup}" Header="Appearance">
              <StackPanel Margin="2,0,10,12">
                <TextBlock Style="{StaticResource Hint}" Text="Halloween for everyone in October, then Mafia gold again. Pick one to keep it. It restarts to apply it, and plays on."/>
                <Border Style="{StaticResource SegmentBar}" Margin="0,12,0,0" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="seg_Theme_Mafia" Style="{StaticResource Segment}" Content="Mafia"/>
                    <RadioButton x:Name="seg_Theme_Halloween" Style="{StaticResource Segment}" Content="Halloween"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </HeaderedContentControl>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

              <HeaderedContentControl Style="{StaticResource TaskGroup}" Header="Discord messages">
                <HeaderedContentControl.Resources><SolidColorBrush x:Key="TileAccent" Color="#8C96F7"/></HeaderedContentControl.Resources>
                <Border Margin="2,0,10,12">
              <StackPanel>
                <TextBlock Style="{StaticResource Hint}" Text="Messages in your own channel. No server? Type /alerts in our Discord."/>
                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1.5" CornerRadius="10" Height="40">
                    <Grid>
                      <PasswordBox x:Name="DiscordLinkBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                                   CaretBrush="{StaticResource Gold}" FontSize="14" VerticalContentAlignment="Center" Padding="12,0" PasswordChar="●"/>
                      <TextBlock x:Name="DiscordLinkHint" Text="Paste your webhook link here" Foreground="{StaticResource Text3}"
                                 VerticalAlignment="Center" Margin="14,0" IsHitTestVisible="False"/>
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button x:Name="BtnDiscordTest" Style="{StaticResource Btn}">
                      <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IcoDiscord}" Width="16" Height="16"/>
                        <TextBlock Text="Send a test" Margin="8,0,0,0" FontWeight="SemiBold"/>
                      </StackPanel>
                    </Button>
                    <Button x:Name="BtnDiscordClear" Style="{StaticResource GhostBtn}" Margin="6,0,0,0">
                      <TextBlock Text="Remove" FontWeight="SemiBold" Foreground="{StaticResource Text2}"/>
                    </Button>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="DiscordStatus" Style="{StaticResource Hint}" Margin="0,8,0,0" Text=""/>

                <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,14,0,12"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="When to send a message" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                  <TextBlock x:Name="DiscordWhenCount" Grid.Column="1" Text="" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                  <ToggleButton x:Name="Fold_DiscordWhen" Grid.Column="2" Style="{StaticResource Fold}" ToolTip="Show or hide when it sends a message"/>
                </Grid>
                <Border x:Name="DiscordWhen" Margin="0,14,0,0">
                  <UniformGrid Columns="3" Margin="0,0,-10,-10">
                    <CheckBox x:Name="sw_DiscordProblems" Style="{StaticResource OptTile}" Content="Problems" ToolTip="Disconnected, stuck, or the bot stopped by itself."/>
                    <CheckBox x:Name="sw_DiscordRarity" Style="{StaticResource OptTile}" Content="Mythic or better henchman" ToolTip="A hire or reroll that brings one."/>
                    <CheckBox x:Name="sw_DiscordProperty" Style="{StaticResource OptTile}" Content="New property" ToolTip="Each property it builds."/>
                    <CheckBox x:Name="sw_DiscordSummary" Style="{StaticResource OptTile}" Content="Update every 3 hours" ToolTip="Your level, cash and what the bot did."/>
                    <CheckBox x:Name="sw_DiscordLevel" Style="{StaticResource OptTile}" Content="Level up" ToolTip="Often on a new account: one message per 10 minutes."/>
                    <CheckBox x:Name="sw_DiscordBoss" Style="{StaticResource OptTile}" Content="Boss beaten" ToolTip="Often: one message per 10 minutes."/>
                  </UniformGrid>
                </Border>
              </StackPanel>
                </Border>
              </HeaderedContentControl>

              <HeaderedContentControl Grid.Column="1" Style="{StaticResource TaskGroup}" Header="Stats in our Discord">
                <HeaderedContentControl.Resources><SolidColorBrush x:Key="TileAccent" Color="#8C96F7"/></HeaderedContentControl.Resources>
                <Border Margin="2,0,10,12">
              <StackPanel>
                <TextBlock x:Name="StatsHint" Style="{StaticResource Hint}" Text="Your level, cash and crew in our Discord. Type /link there and paste its link here. Only game numbers, never your Roblox name or a picture."/>
                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1.5" CornerRadius="10" Height="40">
                    <Grid>
                      <PasswordBox x:Name="StatsLinkBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                                   CaretBrush="{StaticResource Gold}" FontSize="14" VerticalContentAlignment="Center" Padding="12,0" PasswordChar="●"/>
                      <TextBlock x:Name="StatsLinkHint" Text="Paste the link from /link here" Foreground="{StaticResource Text3}"
                                 VerticalAlignment="Center" Margin="14,0" IsHitTestVisible="False"/>
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button x:Name="BtnStatsPreview" Style="{StaticResource Btn}">
                      <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IcoScan}" Width="16" Height="16"/>
                        <TextBlock x:Name="StatsPreviewLabel" Text="What it sends" Margin="8,0,0,0" FontWeight="SemiBold"/>
                      </StackPanel>
                    </Button>
                    <Button x:Name="BtnStatsClear" Style="{StaticResource GhostBtn}" Margin="6,0,0,0">
                      <TextBlock Text="Remove" FontWeight="SemiBold" Foreground="{StaticResource Text2}"/>
                    </Button>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="StatsStatus" Style="{StaticResource Hint}" Margin="0,8,0,0" Text=""/>

                <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,14,0,12"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <CheckBox x:Name="sw_RemoteControl" Style="{StaticResource TaskTile}" Tag="{StaticResource IcoPlay}" Content="Remote control from Discord"
                            ToolTip="/remote in our Discord: start, stop, status, a preset or a problem report. Nothing else."/>
                  <TextBlock x:Name="RemoteHint" Grid.Column="1" Style="{StaticResource Hint}" Margin="14,0,0,0" VerticalAlignment="Center"
                             Text="Off. Switch it on to use /remote in our Discord: start, stop, status, a preset or a problem report."/>
                </Grid>
                <Border x:Name="StatsPreviewBox" Visibility="Collapsed" Background="{StaticResource Field}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1.5" CornerRadius="10" Margin="0,12,0,0" Padding="12,10">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="Exactly what goes to the link, as it is now. Numbers the bot hasn't read yet are left out."/>
                    <TextBox x:Name="StatsPreview" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                             FontFamily="Consolas" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0" MaxHeight="300"
                             VerticalScrollBarVisibility="Auto"/>
                  </StackPanel>
                </Border>
              </StackPanel>
                </Border>
              </HeaderedContentControl>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <HeaderedContentControl Style="{StaticResource TaskGroup}" Header="What it never presses">
                <HeaderedContentControl.Resources><SolidColorBrush x:Key="TileAccent" Color="#E05A4C"/></HeaderedContentControl.Resources>
                <Border Margin="2,0,10,12">
              <StackPanel>

                <Button x:Name="BtnNeverList" Style="{StaticResource Btn}" HorizontalAlignment="Left">
                  <TextBlock x:Name="NeverListText" Text="Show the full list" FontWeight="SemiBold"/>
                </Button>
                <StackPanel x:Name="NeverList" Visibility="Collapsed" Margin="0,4,0,0">
                  <TextBlock Text="Never" FontWeight="SemiBold" FontSize="13.5" Margin="0,12,0,0"/>
                  <TextBlock Style="{StaticResource Hint}" Text="• Anything that costs Robux or tickets, and the + refill buttons" Margin="10,4,0,0"/>
                  <TextBlock Style="{StaticResource Hint}" Text="• FINISH NOW, REPLACE, SABOTAGE, DELETE, AUTO ROLL" Margin="10,4,0,0"/>
                  <TextBlock Style="{StaticResource Hint}" Text="• LEAVE FAMILY, MAKE BOSS, DONATE, DECLARE WAR, INVITE, EDIT, SAVE, JOIN" Margin="10,4,0,0"/>
                  <TextBlock Style="{StaticResource Hint}" Text="• A collection card's own DEPOSIT, STOP on a henchman in training, briefcase keys, Bandages and Medkits" Margin="10,4,0,0"/>
                  <TextBlock Style="{StaticResource Hint}" Text="• Trade and the Black Market" Margin="10,4,0,0"/>
                  <TextBlock Text="Only with its tile on, and only with your cash" FontWeight="SemiBold" FontSize="13.5" Margin="0,12,0,0"/>
                  <TextBlock Style="{StaticResource Hint}" Text="• BUILD on Properties, UPGRADE on the Safehouse" Margin="10,4,0,0"/>
                  <TextBlock Style="{StaticResource Hint}" Text="• UNLOCK SLOT and the hires on the Crew, DISMISS on your worst henchman to reroll it, TRAIN" Margin="10,4,0,0"/>
                  <TextBlock Style="{StaticResource Hint}" Text="• WITHDRAW ALL at the bank, for one of those buys, a Mythic or rarer shop item or your own heist's stake" Margin="10,4,0,0"/>
                  <TextBlock Text="Only in these cases" FontWeight="SemiBold" FontSize="13.5" Margin="0,12,0,0"/>
                  <TextBlock Style="{StaticResource Hint}" Text="• DEMOLISH on your weakest property, when a better one is ready to build" Margin="10,4,0,0"/>
                  <TextBlock Style="{StaticResource Hint}" Text="• UNEQUIP ALL to read your crew's own stats for rerolls, then AUTO EQUIP BEST" Margin="10,4,0,0"/>
                  <TextBlock Style="{StaticResource Hint}" Text="• SCOUT on a player's profile before a fight (1 stamina, with Scout players first on)" Margin="10,4,0,0"/>
                  <TextBlock Style="{StaticResource Hint}" Text="• START A HEIST and its START, for a heist of your own (with Start my own heist on)" Margin="10,4,0,0"/>
                  <TextBlock Style="{StaticResource Hint}" Text="• STATION ALL in a district of your family under attack, RECALL after, HEAL on its beaten defenders (with Defend districts on)" Margin="10,4,0,0" TextWrapping="Wrap"/>
                  <TextBlock Style="{StaticResource Hint}" Text="• CANCEL, to back out of a crew or property window it won't go ahead with" Margin="10,4,0,0"/>
                  <TextBlock Style="{StaticResource Hint}" Text="In the Shop it only buys items priced in cash. If a Robux purchase window opens, it stops." Margin="0,12,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
                </Border>
              </HeaderedContentControl>
              <HeaderedContentControl Grid.Column="1" Style="{StaticResource TaskGroup}" Header="Help" VerticalAlignment="Top">
                <Border Margin="2,0,10,12">

                  <Grid MinHeight="{Binding ActualHeight, ElementName=BtnNeverList}">
                    <WrapPanel Margin="-8,0,0,0" VerticalAlignment="Center">
                      <Button x:Name="BtnDiscord" Style="{StaticResource GhostBtn}" Padding="8,6" ToolTip="Questions, problems or ideas? Ask in the Discord">
                        <StackPanel Orientation="Horizontal">
                          <Path Data="{StaticResource IcoDiscord}" Fill="#8C96F7" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                          <TextBlock Text="Discord" Margin="6,0,0,0" FontSize="13" Foreground="{StaticResource Text2}"/>
                        </StackPanel>
                      </Button>
                      <Button x:Name="BtnStar" Style="{StaticResource GhostBtn}" Padding="8,6" ToolTip="It's free. A star on GitHub helps other players find it.">
                        <StackPanel Orientation="Horizontal">
                          <Path Data="{StaticResource IcoStar}" Fill="{StaticResource Gold}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                          <TextBlock Text="Star on GitHub" Margin="6,0,0,0" FontSize="13" Foreground="{StaticResource Text2}"/>
                        </StackPanel>
                      </Button>
                      <Button x:Name="BtnDownloads" Style="{StaticResource GhostBtn}" Padding="8,6" ToolTip="New versions come out here">
                        <TextBlock Text="Download page" FontSize="13" Foreground="{StaticResource Text2}"/>
                      </Button>
                    </WrapPanel>
                    <TextBlock x:Name="VersionText" Text="" Style="{StaticResource Label}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SupportVersion" Visibility="Collapsed"/>
                  </Grid>
                </Border>
              </HeaderedContentControl>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <Grid x:Name="OptionsLayer" Grid.ColumnSpan="2" Background="#B3000000" Visibility="Collapsed">
      <Border x:Name="OptionsPanel" Width="680" Margin="0,96,0,32" VerticalAlignment="Center" HorizontalAlignment="Center"
              CornerRadius="12" BorderBrush="#3A321C" BorderThickness="1">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#221E14" Offset="0"/>
            <GradientStop Color="#1A1A1C" Offset="0.25"/>
            <GradientStop Color="#18181A" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="24,18,12,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Path x:Name="OptionsIcon" Stroke="{DynamicResource TileAccent}" Width="20" Height="20" Stretch="Uniform" StrokeThickness="1.8"
                    StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"/>
              <TextBlock x:Name="OptionsTitle" Text="" FontFamily="{StaticResource Deco}" FontSize="21" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Button x:Name="BtnOptionsClose" Style="{StaticResource WinBtn}" HorizontalAlignment="Right" ToolTip="Close (Esc)">
              <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource Text2}" StrokeThickness="1.4"/>
            </Button>
          </Grid>
          <ScrollViewer x:Name="OptionsScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="OptionsBody" Margin="24,8,24,20">

              <StackPanel x:Name="Opt_Presets" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="2,0,0,12"
                           Text="A preset keeps every task switch and its options. Pick one to switch them all at once. Your Discord links, your account and your PC's settings are never in a preset."/>
                <TextBlock Text="Your presets" Style="{StaticResource OptHead}" Margin="0,4,0,10"/>
                <StackPanel x:Name="PresetList"/>
                <TextBlock x:Name="PresetEmpty" Style="{StaticResource Hint}" Margin="2,0,0,10" Text="None yet. Save what's on now below."/>
                <TextBlock Text="Save what's on now" Style="{StaticResource OptHead}"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1.5" CornerRadius="10" Height="40">
                    <Grid>
                      <TextBox x:Name="PresetNameBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" MaxLength="30"
                               CaretBrush="{StaticResource Gold}" FontSize="14" VerticalContentAlignment="Center" Padding="10,0"/>
                      <TextBlock x:Name="PresetNameHint" Text="A name, like Reroll night" Foreground="{StaticResource Text3}"
                                 VerticalAlignment="Center" Margin="14,0" IsHitTestVisible="False"/>
                    </Grid>
                  </Border>
                  <Button x:Name="BtnPresetSave" Grid.Column="1" Style="{StaticResource PrimaryBtn}" Margin="10,0,0,0" Content="Save"/>
                </Grid>
                <TextBlock Text="Add a shared code" Style="{StaticResource OptHead}"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1.5" CornerRadius="10" Height="40">
                    <Grid>
                      <TextBox x:Name="PresetCodeBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                               CaretBrush="{StaticResource Gold}" FontSize="13" VerticalContentAlignment="Center" Padding="10,0"/>
                      <TextBlock x:Name="PresetCodeHint" Text="Paste a code from Discord (IMB-PRESET-1:...)" Foreground="{StaticResource Text3}"
                                 VerticalAlignment="Center" Margin="14,0" IsHitTestVisible="False"/>
                    </Grid>
                  </Border>
                  <Button x:Name="BtnPresetPaste" Grid.Column="1" Style="{StaticResource Btn}" Margin="10,0,0,0" Content="Paste"/>
                </Grid>
                <Border x:Name="PresetPreview" Style="{StaticResource OptLine}" Margin="0,10,0,0" Visibility="Collapsed">
                  <StackPanel>
                    <TextBlock x:Name="PresetPreviewTitle" FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PresetPreviewOn" FontSize="13" Foreground="{StaticResource Gold}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock x:Name="PresetPreviewOff" FontSize="13" Foreground="{StaticResource Text3}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                      <Button x:Name="BtnPresetAddUse" Style="{StaticResource PrimaryBtn}" Content="Add and use it"/>
                      <Button x:Name="BtnPresetAdd" Style="{StaticResource Btn}" Margin="8,0,0,0" Content="Add"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <TextBlock x:Name="PresetStatus" Style="{StaticResource Hint}" Margin="2,10,0,0" Text="" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel x:Name="Opt_Rejoin" Visibility="Collapsed">
                <Border Style="{StaticResource OptLine}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="Played on another device" FontSize="14"/>
                      <TextBlock Text="When you join the game somewhere else, the bot waits this long, then joins again. That throws the other device out, so pick a time longer than you usually play there." Style="{StaticResource Hint}" FontSize="12.5" TextWrapping="Wrap"/></StackPanel>
                    <Border Style="{StaticResource SegmentBar}" Grid.Column="1" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><RadioButton x:Name="seg_OtherDeviceRejoin_Off" GroupName="otherdevice" Style="{StaticResource Segment}" Content="Off"/><RadioButton x:Name="seg_OtherDeviceRejoin_M15" GroupName="otherdevice" Style="{StaticResource Segment}" Content="15 min"/><RadioButton x:Name="seg_OtherDeviceRejoin_M30" GroupName="otherdevice" Style="{StaticResource Segment}" Content="30 min"/><RadioButton x:Name="seg_OtherDeviceRejoin_H1" GroupName="otherdevice" Style="{StaticResource Segment}" Content="1 h"/><RadioButton x:Name="seg_OtherDeviceRejoin_H2" GroupName="otherdevice" Style="{StaticResource Segment}" Content="2 h"/></StackPanel></Border>
                  </Grid>
                </Border>
              </StackPanel>
              <StackPanel x:Name="Opt_Jobs" Visibility="Collapsed">
                <Border Style="{StaticResource OptLine}">
                  <StackPanel>
                    <Grid><TextBlock Text="Now" FontSize="12" Foreground="{StaticResource Text3}"/><TextBlock x:Name="JobModeText" Text="" FontSize="12" Foreground="{StaticResource Text3}" HorizontalAlignment="Right"/></Grid>
                    <TextBlock x:Name="JobName" Text="-" FontSize="14.5" FontWeight="SemiBold" Margin="0,4,0,1" TextWrapping="Wrap" TextTrimming="None"/>
                    <TextBlock x:Name="JobMeta" Text="" FontSize="12.5" Foreground="{StaticResource Text2}" TextWrapping="Wrap"/>
                    <Border Margin="0,10,0,0"><Grid Height="4"><Border CornerRadius="2" Background="{StaticResource Track}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="JobMasteryA" Width="0*"/><ColumnDefinition x:Name="JobMasteryB" Width="1*"/></Grid.ColumnDefinitions><Border CornerRadius="2" Background="{StaticResource Gold}"/></Grid></Grid></Border>
                    <TextBlock x:Name="JobMasteryText" Text="" FontSize="12" Foreground="{StaticResource Text3}" Margin="0,6,0,0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource OptLine}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="Which job" FontSize="14"/></StackPanel>
                    <Border Style="{StaticResource SegmentBar}" Grid.Column="1" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><RadioButton x:Name="seg_JobMode_BestXp" GroupName="jobmode" Style="{StaticResource Segment}" Content="Best XP"/><RadioButton x:Name="seg_JobMode_Mastery" GroupName="jobmode" Style="{StaticResource Segment}" Content="Finish mastery"/><RadioButton x:Name="seg_JobMode_OneJob" GroupName="jobmode" Style="{StaticResource Segment}" Content="One job"/></StackPanel></Border>
                  </Grid>
                </Border>
                <TextBlock x:Name="JobModeHint" Style="{StaticResource Hint}" Margin="2,0,0,0"/>
                <Border x:Name="OneJobWhyBox" CornerRadius="10" Background="{StaticResource Panel2}" Padding="12,8" Margin="0,12,0,0" HorizontalAlignment="Left" Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IcoBolt}" Stroke="{StaticResource Energy}" Width="14" Height="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OneJobWhy" FontSize="13" Foreground="{StaticResource Text}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
                <Grid Margin="0,18,0,10"><TextBlock Text="Mastery" Style="{StaticResource OptHead}" Margin="0"/><TextBlock x:Name="MasterySummary" Text="" FontSize="12" Foreground="{StaticResource Text3}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6" Text="Bronze at 25 jobs, Silver at 50, Gold at 100. Gold gives a skill point. In One job, a click on a job picks it."/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-16,0" MaxHeight="340">
                <ItemsControl x:Name="JobList" Margin="0,0,16,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid>

                        <Button Command="{Binding Toggle}" Cursor="Hand" Focusable="False" Margin="0,8,0,6" HorizontalContentAlignment="Stretch">
                          <Button.Style>
                            <Style TargetType="Button">
                              <Setter Property="Template">
                                <Setter.Value>
                                  <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bar" CornerRadius="10" Background="#212123" BorderBrush="#D4AF37" BorderThickness="0,0,0,1.5" Padding="16,10,12,10">
                                      <ContentPresenter HorizontalAlignment="Stretch"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Background" Value="#2A2A2D"/></Trigger>
                                    </ControlTemplate.Triggers>
                                  </ControlTemplate>
                                </Setter.Value>
                              </Setter>
                              <Style.Triggers><DataTrigger Binding="{Binding IsHeader}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                            </Style>
                          </Button.Style>
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Header}" FontFamily="Palatino Linotype, Georgia" FontSize="17" Foreground="#D4AF37" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="12.5" Foreground="#A8A292" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Border Grid.Column="2" Width="26" Height="26" CornerRadius="5" BorderBrush="#D4AF37" BorderThickness="1.5">
                              <TextBlock Text="{Binding Sign}" FontSize="18" FontWeight="Bold" Foreground="#D4AF37" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/>
                            </Border>
                          </Grid>
                        </Button>

                        <Button Command="{Binding Pick}" IsEnabled="{Binding Pickable}" Focusable="False" Margin="0,0,0,3" HorizontalContentAlignment="Stretch">
                          <Button.Style>
                            <Style TargetType="Button">
                              <Setter Property="Background" Value="{Binding RowBg}"/>
                              <Setter Property="Template">
                                <Setter.Value>
                                  <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="10" Padding="12,8" Background="{TemplateBinding Background}">
                                      <ContentPresenter HorizontalAlignment="Stretch"/>
                                    </Border>
                                  </ControlTemplate>
                                </Setter.Value>
                              </Setter>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHeader}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                <DataTrigger Binding="{Binding Pickable}" Value="True"><Setter Property="Cursor" Value="Hand"/></DataTrigger>
                                <MultiDataTrigger>
