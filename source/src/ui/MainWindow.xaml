                    <TextBlock x:Name="TdStage" Text="-" FontWeight="SemiBold" FontSize="14.5" Margin="0,5,0,0"/>
                    <Grid Height="8" Margin="0,9,0,0">
                      <Border CornerRadius="4" Background="{StaticResource Track}"/>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition x:Name="TdHpA" Width="0*"/><ColumnDefinition x:Name="TdHpB" Width="1*"/></Grid.ColumnDefinitions>
                        <Border CornerRadius="4" Background="{StaticResource Health}"/>
                      </Grid>
                    </Grid>
                    <TextBlock x:Name="TdHp" Text="" Style="{StaticResource Label}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="TdRead" Style="{StaticResource Hint}" Margin="0,16,0,0" Text=""/>
                </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel x:Name="Opt_GiveStamina" Visibility="Collapsed">
                <Border Style="{StaticResource OptLine}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="Keep stamina for bosses" FontSize="14"/>
                      <TextBlock Text="Gifts, player fights and the Takedown leave this much. Half your bar at most." Style="{StaticResource Hint}" FontSize="12.5"/></StackPanel>
                    <ContentControl x:Name="num_FightStaminaReserve" Grid.Column="1" Tag="0,500,1," VerticalAlignment="Center"/>
                  </Grid>
                </Border>
                <Border Style="{StaticResource OptLine}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="Give it to" FontSize="14"/></StackPanel>
                    <ComboBox x:Name="cmb_StaminaPerk" Grid.Column="1" Width="260" Height="36" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
                <TextBlock x:Name="PerkHint" Style="{StaticResource Hint}" Margin="2,0,0,0"/>
                <Border x:Name="GiveWhyBox" CornerRadius="10" Background="{StaticResource Panel2}" Padding="12,8" Margin="0,12,0,0" HorizontalAlignment="Left" Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IcoBolt}" Stroke="{StaticResource Stamina}" Width="14" Height="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="GiveWhy" FontSize="13" Foreground="{StaticResource Text}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel x:Name="Opt_DefendTerritory" Visibility="Collapsed">
                <UniformGrid Columns="3" Margin="0,0,-10,0">
                  <CheckBox x:Name="sw_DefendHeal" Style="{StaticResource OptTile}" Content="Heal defenders with stamina" ToolTip="During an attack. Keeps the stamina for bosses and fights."/>
                </UniformGrid>
              </StackPanel>
              <StackPanel x:Name="Opt_Operations" Visibility="Collapsed">
                <TextBlock x:Name="OpsEmpty" Text="Not read yet." Style="{StaticResource Hint}" Margin="2,0,0,8"/>
                <ItemsControl x:Name="OpsList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#1A1A1C" BorderBrush="#222225" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                        <StackPanel>
                          <Grid>
                            <TextBlock Text="{Binding Name}" FontSize="13.5" Foreground="#E8E2D0"/>
                            <TextBlock Text="{Binding Left}" FontSize="12.5" Foreground="#A8A292" HorizontalAlignment="Right"/>
                          </Grid>
                          <Grid Height="4" Margin="0,8,0,0">
                            <Border CornerRadius="2" Background="#0D0D0E"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="{Binding A}"/><ColumnDefinition Width="{Binding B}"/></Grid.ColumnDefinitions><Border CornerRadius="2" Background="#5B8FB9"/></Grid>
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel x:Name="Opt_Bank" Visibility="Collapsed">
                <TextBlock Text="The bot banks everything after every round. Amount: it also banks whenever the cash on hand reaches it - useful while it fights, since a fights session runs long without a round." Style="{StaticResource Hint}" Margin="2,0,0,10"/>
                <Border Style="{StaticResource OptLine}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="Auto bank at" FontSize="14"/>
                      <TextBlock Text="Off: only after each round, like before." Style="{StaticResource Hint}" FontSize="12.5"/></StackPanel>
                    <ComboBox x:Name="cmb_BankAt" Grid.Column="1" Width="260" Height="36" VerticalAlignment="Center" ToolTip="The cash on hand that makes the bot bank right away - Off banks only after each round"/>
                  </Grid>
                </Border>
              </StackPanel>
              <StackPanel x:Name="Opt_Properties" Visibility="Collapsed">
                <Border Style="{StaticResource OptLine}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="Which property to build" FontSize="14"/>
                      <TextBlock Text="Pick one and the bot only builds that one, also in place of lots that earn less. Best one: the bot picks." Style="{StaticResource Hint}" FontSize="12.5"/></StackPanel>
                    <ComboBox x:Name="cmb_PropertyOnly" Grid.Column="1" Width="260" Height="36" VerticalAlignment="Center" MaxDropDownHeight="420" ToolTip="Which property the bot builds"/>
                  </Grid>
                </Border>
                <Border Style="{StaticResource OptLine}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="Lots for gold properties" FontSize="14"/>
                      <TextBlock Text="Lots that get a property making gold bars (level 125+), once the others hold the best. 0 = none." Style="{StaticResource Hint}" FontSize="12.5"/></StackPanel>
                    <ContentControl x:Name="num_GoldLots" Grid.Column="1" Tag="0,50,1," VerticalAlignment="Center"/>
                  </Grid>
                </Border>
              </StackPanel>
              <StackPanel x:Name="Opt_SafehouseUpgrade" Visibility="Collapsed">

                <Border Style="{StaticResource OptLine}" Padding="16,14">
                  <StackPanel>
                    <Grid>
                      <TextBlock Text="Your mafia" FontSize="14"/>
                      <TextBlock x:Name="SafeWhen" Text="read once a day" Style="{StaticResource Label}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <UniformGrid Columns="3" Margin="0,12,0,0">
                      <StackPanel Margin="0,0,0,12"><TextBlock x:Name="SafeLevel" Text="-" Style="{StaticResource Big}"/><TextBlock x:Name="SafeLevelSub" Text="safehouse" Style="{StaticResource Label}"/></StackPanel>
                      <StackPanel Margin="0,0,0,12"><TextBlock x:Name="SafeRespect" Text="-" Style="{StaticResource Big}"/><TextBlock Text="respect" Style="{StaticResource Label}"/></StackPanel>
                      <StackPanel Margin="0,0,0,12"><TextBlock x:Name="SafeIncome" Text="-" Style="{StaticResource Big}"/><TextBlock Text="income an hour" Style="{StaticResource Label}"/></StackPanel>
                      <StackPanel><TextBlock x:Name="SafeAttack" Text="-" Style="{StaticResource Big}"/><TextBlock Text="attack power" Style="{StaticResource Label}"/></StackPanel>
                      <StackPanel><TextBlock x:Name="SafeDefense" Text="-" Style="{StaticResource Big}"/><TextBlock Text="defense power" Style="{StaticResource Label}"/></StackPanel>
                      <StackPanel><TextBlock x:Name="SafeCrew" Text="-" Style="{StaticResource Big}"/><TextBlock x:Name="SafeCrewSub" Text="henchmen" Style="{StaticResource Label}"/></StackPanel>
                    </UniformGrid>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel x:Name="Opt_SpendPoints" Visibility="Collapsed">
                <Border Style="{StaticResource OptLine}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="Spend them on" FontSize="14"/></StackPanel>
                    <ComboBox x:Name="cmb_PointsStat" Grid.Column="1" Width="240" Height="36" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
              </StackPanel>
              <StackPanel x:Name="Opt_ShopBuy" Visibility="Collapsed">
                <TextBlock Text="Rarities to buy" Style="{StaticResource OptHead}" Margin="0,0,0,4"/>
                <TextBlock x:Name="ShopRaritiesHint" Text="" Style="{StaticResource Hint}"/>
                <WrapPanel Margin="0,10,0,6">
                  <CheckBox x:Name="sw_ShopCommon" Style="{StaticResource RarityChip}" Tag="{StaticResource RarityCommon}" Content="Common"/>
                  <CheckBox x:Name="sw_ShopUncommon" Style="{StaticResource RarityChip}" Tag="{StaticResource RarityUncommon}" Content="Uncommon"/>
                  <CheckBox x:Name="sw_ShopRare" Style="{StaticResource RarityChip}" Tag="{StaticResource RarityRare}" Content="Rare"/>
                  <CheckBox x:Name="sw_ShopEpic" Style="{StaticResource RarityChip}" Tag="{StaticResource RarityEpic}" Content="Epic"/>
                  <CheckBox x:Name="sw_ShopLegendary" Style="{StaticResource RarityChip}" Tag="{StaticResource RarityLegendary}" Content="Legendary"/>
                  <CheckBox x:Name="sw_ShopMythic" Style="{StaticResource RarityChip}" Tag="{StaticResource RarityMythic}" Content="Mythic"/>
                  <CheckBox x:Name="sw_ShopSecret" Style="{StaticResource RarityChip}" Tag="{StaticResource RaritySecret}" Content="Secret"/>
                  <CheckBox x:Name="sw_ShopForbidden" Style="{StaticResource RarityChip}" Tag="{StaticResource RarityForbidden}" Content="Forbidden"/>
                </WrapPanel>
                <UniformGrid Columns="3" Margin="0,0,-10,0">
                  <CheckBox x:Name="sw_ShopWithdraw" Style="{StaticResource OptTile}" Content="Take cash out of the bank" ToolTip="For the rarities below, with the No Bank Fees pass."/>
                </UniformGrid>
                <WrapPanel Margin="0,0,0,0">
                  <TextBlock Text="Only for" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,8"/>
                  <CheckBox x:Name="sw_ShopBankMythic" Style="{StaticResource RarityChip}" Tag="{StaticResource RarityMythic}" Content="Mythic"/>
                  <CheckBox x:Name="sw_ShopBankSecret" Style="{StaticResource RarityChip}" Tag="{StaticResource RaritySecret}" Content="Secret"/>
                  <CheckBox x:Name="sw_ShopBankForbidden" Style="{StaticResource RarityChip}" Tag="{StaticResource RarityForbidden}" Content="Forbidden"/>
                </WrapPanel>
                <HeaderedContentControl x:Name="MarketCard" Style="{StaticResource Section}" Header="Black Market" Tag="{StaticResource IcoBag}" Visibility="Collapsed">
                  <StackPanel>
                    <UniformGrid Columns="3" Margin="0,0,-10,0"><CheckBox x:Name="sw_MarketRelist" Style="{StaticResource OptTile}" Content="Relist my listings" ToolTip="Takes each of your listings out and puts it back, same amount and price, so it shows first again."/></UniformGrid>
                    <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,14"/>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Relist every" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock Text="5 to 60 minutes. You make the listings, the bot only puts them back up." Style="{StaticResource Hint}"/>
                      </StackPanel>
                      <ContentControl x:Name="num_MarketMinutes" Grid.Column="1" Tag="5,60,5,min" VerticalAlignment="Center"/>
                    </Grid>
                  </StackPanel>
                </HeaderedContentControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <StackPanel x:Name="Toasts" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,96,26,0" Width="350" IsHitTestVisible="False"/>

    <Grid x:Name="Review" Grid.ColumnSpan="2" Background="#E6070708" Visibility="Collapsed">

        <Border Style="{StaticResource Card}" MaxWidth="1060" Margin="30" Padding="30,24,30,20" BorderBrush="{StaticResource Line}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border Width="58" Height="58" CornerRadius="16" Background="{StaticResource Rail}">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IcoScan}" Stroke="{StaticResource Gold}" Width="26" Height="26"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Your game, checked" Style="{StaticResource PageTitle}" FontSize="28"/>
                <TextBlock x:Name="ReviewSub" Text="" Style="{StaticResource Label}" Margin="1,2,0,0"/>
              </StackPanel>
              <Button x:Name="BtnReviewClose" Grid.Column="2" Style="{StaticResource WinBtn}" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close (your settings stay as they are)">
                <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource Text2}" StrokeThickness="1.2"/>
              </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,-16,0">
            <Grid Margin="0,0,16,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="3*"/>
              </Grid.ColumnDefinitions>

              <StackPanel>
                <TextBlock Text="WHAT I FOUND" Style="{StaticResource Label}" Foreground="{StaticResource Gold}" Margin="0,0,0,12"/>
                <ItemsControl x:Name="FoundList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,11">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="#6F6B61" Margin="0,1,8,0" TextWrapping="Wrap" TextTrimming="None"/>
                        <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="13.5" Foreground="#E8E2D0" TextWrapping="Wrap" TextTrimming="None"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Grid.Column="2">
                <TextBlock Text="WHAT I'D SET UP" Style="{StaticResource Label}" Foreground="{StaticResource Gold}" Margin="0,0,0,12"/>
                <TextBlock Text="Your focus" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                <Border Style="{StaticResource SegmentBar}">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="seg_Focus_Balanced" GroupName="focus" Style="{StaticResource Segment}" Content="Balanced"/>
                    <RadioButton x:Name="seg_Focus_XP" GroupName="focus" Style="{StaticResource Segment}" Content="XP"/>
                    <RadioButton x:Name="seg_Focus_Money" GroupName="focus" Style="{StaticResource Segment}" Content="Money"/>
                    <RadioButton x:Name="seg_Focus_Family" GroupName="focus" Style="{StaticResource Segment}" Content="Family"/>
                  </StackPanel>
                </Border>
                <TextBlock x:Name="FocusHint" Style="{StaticResource Hint}" Margin="0,8,0,18"/>
                <TextBlock x:Name="ChangesEmpty" Text="Your settings already fit your game." Style="{StaticResource Hint}" Margin="0,0,0,8" Visibility="Collapsed"/>
                <ItemsControl x:Name="ChangeList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border CornerRadius="10" Background="#212123" Padding="14,10" Margin="0,0,0,6">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <StackPanel>
                            <WrapPanel>
                              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#E8E2D0" Margin="0,0,10,0"/>
                              <TextBlock Text="{Binding Old}" FontSize="13" Foreground="#6F6B61" TextDecorations="Strikethrough" VerticalAlignment="Bottom"/>
                              <TextBlock Text="  &#8594;  " FontSize="13" Foreground="#6F6B61" VerticalAlignment="Bottom"/>
                              <TextBlock Text="{Binding New}" FontSize="13" FontWeight="Bold" Foreground="#D4AF37" VerticalAlignment="Bottom"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding Reason}" FontSize="12.5" Foreground="#A8A292" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0"/>

                            <TextBlock Text="{Binding Note}" FontSize="12.5" FontWeight="SemiBold" Foreground="#D4AF37" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Style.Triggers><DataTrigger Binding="{Binding Note}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </StackPanel>
                          <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding Use, Mode=TwoWay}" VerticalAlignment="Center" Margin="16,0,0,0"
                                    ToolTip="On: use this. Off: keep your own setting."/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="KeptTitle" Text="ALREADY SET LIKE THIS" Style="{StaticResource Label}" Margin="0,16,0,10"/>
                <ItemsControl x:Name="KeptList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,0,0,9">
                        <WrapPanel>
                          <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#A8A292" Margin="0,0,8,0"/>
                          <TextBlock Text="{Binding New}" FontSize="13" Foreground="#A8A292"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding Reason}" FontSize="12" Foreground="#6F6B61" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0"/>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Grid>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,16,0,0">
              <Border Height="1" Background="{StaticResource LineSoft}" VerticalAlignment="Top" Margin="0,-2,0,0"/>
              <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="ReviewNote" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,20,0"
                         Text="Nothing changes until you press Use these settings. Switch a line off to keep your own setting."/>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnKeepSettings" Style="{StaticResource GhostBtn}" Margin="0,0,10,0">
                  <TextBlock x:Name="KeepText" Text="Keep my settings" FontWeight="SemiBold" Foreground="{StaticResource Text2}"/>
                </Button>
                <Button x:Name="BtnUseSettings" Style="{StaticResource PrimaryBtn}" Padding="24,11" MinWidth="180">
                  <TextBlock x:Name="UseText" Text="Use these settings" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource OnGold}"/>
                </Button>
              </StackPanel>
              </Grid>
            </Grid>
          </Grid>
        </Border>
    </Grid>

    <Grid x:Name="Welcome" Grid.ColumnSpan="2" Background="#E6070708" Visibility="Collapsed">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Width="760" Margin="30" Padding="36,30" HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="{StaticResource Line}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Width="58" Height="58" CornerRadius="16" Background="{StaticResource Rail}">
                <Path Data="{StaticResource IcoFedora}" Fill="{StaticResource Gold}" Width="38" Height="38" Stretch="Uniform"/>
              </Border>
              <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Welcome to Idle Mafia Bot" Style="{StaticResource PageTitle}" FontSize="28"/>
                <TextBlock x:Name="WelcomeVersion" Text="" Style="{StaticResource Label}" Margin="1,1,0,0"/>
              </StackPanel>
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" FontSize="14" Foreground="{StaticResource Text}" Margin="0,20,0,0"
                       Text="It plays Idle Mafia Game on Roblox for you. Every task is a tile on the Tasks page: gold is on, click it to turn it off."/>

            <Grid Margin="0,20,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource GoldSoft}" VerticalAlignment="Top">
                <Path Data="{StaticResource IcoPlay}" Fill="{StaticResource Gold}" Width="13" Height="13" Stretch="Uniform"/>
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Start and stop" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                           Text="Open the game in Roblox, at any window size, and press Start or F6. While you use the PC it waits, then borrows the mouse for a few seconds."/>
              </StackPanel>
            </Grid>
            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource GoldSoft}" VerticalAlignment="Top">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IcoScan}" Stroke="{StaticResource Gold}" Width="18" Height="18"/>
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="It only looks and clicks" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                           Text="It reads the screen and moves the mouse, like you would. It never changes Roblox."/>
              </StackPanel>
            </Grid>
            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource GoldSoft}" VerticalAlignment="Top">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IcoShield}" Stroke="{StaticResource Gold}" Width="18" Height="18"/>
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="What it never presses" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                           Text="Anything that costs Robux, and risky buttons like DELETE, SABOTAGE or LEAVE&#160;FAMILY. The full list is in Settings. If a Robux purchase window opens, it stops."/>
              </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource Hint}" Margin="0,20,0,0"
                       Text="Updating from an older version? Put this IdleMafiaBot.exe in your old folder, in place of the old one, so your settings stay. After that, Check for updates on the Settings page does it for you."/>

            <Grid Margin="0,26,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Button x:Name="BtnWelcomeDiscord" Style="{StaticResource PrimaryBtn}" Background="#5865F2" Padding="18,11"
                      ToolTip="Questions, problems or ideas? Ask in the Discord">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource IcoDiscord}" Fill="White" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"/>
                  <TextBlock Text="Join the Discord" Margin="9,0,0,0" FontWeight="Bold" FontSize="14.5" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="BtnWelcomeOk" Grid.Column="2" Style="{StaticResource PrimaryBtn}" Padding="24,11" MinWidth="160">
                <TextBlock Text="Let's go" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource OnGold}"/>
              </Button>
            </Grid>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Grid>

    <Grid x:Name="Rules" Grid.ColumnSpan="2" Background="#F0070708" Visibility="Collapsed">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Width="760" Margin="30" Padding="36,30" HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="{StaticResource Line}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Width="58" Height="58" CornerRadius="16" Background="{StaticResource Rail}">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IcoShield}" Stroke="{StaticResource Gold}" Width="34" Height="34"/>
              </Border>
              <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Guidelines" Style="{StaticResource PageTitle}" FontSize="28"/>
                <TextBlock Text="Shown every time the app starts" Style="{StaticResource Label}" Margin="1,1,0,0"/>
              </StackPanel>
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" FontSize="14" Foreground="{StaticResource Text}" Margin="0,18,0,0"
                       Text="Idle Mafia Bot is free and made to keep your own game going while you're away. By using it you agree to these rules."/>

            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource GoldSoft}" VerticalAlignment="Top">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IcoCrew}" Stroke="{StaticResource Gold}" Width="18" Height="18"/>
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Only your own account" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                           Text="Play your own game with it. Don't run it on other people's accounts, and don't level up accounts for others."/>
              </StackPanel>
            </Grid>
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource GoldSoft}" VerticalAlignment="Top">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IcoBank}" Stroke="{StaticResource Gold}" Width="18" Height="18"/>
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Never sell accounts" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                           Text="Don't sell, buy or trade accounts or game items for real money. Roblox doesn't allow it."/>
              </StackPanel>
            </Grid>
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource GoldSoft}" VerticalAlignment="Top">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IcoFlag}" Stroke="{StaticResource Gold}" Width="18" Height="18"/>
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Follow Roblox's rules and the game's" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                           Text="Stick to the Roblox Terms of Use, the Community Standards and the game's own rules. If they ever say no to macros like this one, stop using it."/>
              </StackPanel>
            </Grid>
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource GoldSoft}" VerticalAlignment="Top">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IcoLock}" Stroke="{StaticResource Gold}" Width="18" Height="18"/>
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Keep your account safe" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                           Text="Download the bot only from github.com/geenusername/IdleMafiaBot. It never asks for your password, so never give it to anyone."/>
              </StackPanel>
            </Grid>
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource GoldSoft}" VerticalAlignment="Top">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IcoDownload}" Stroke="{StaticResource Gold}" Width="18" Height="18"/>
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Share it, don't sell it" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                           Text="The bot is free. Don't sell it or upload copies of it. Send people the GitHub page instead, and only post it where that's allowed."/>
              </StackPanel>
            </Grid>

            <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,24,0,0"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,16,0,0"
                       Text="You are responsible for how you use the bot and for your own account. The maker of this app is not responsible for what you do with it. If you don't agree, press Close and the app closes."/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
              <Button x:Name="BtnRulesClose" Style="{StaticResource GhostBtn}" Margin="0,0,10,0">
                <TextBlock Text="Close" FontWeight="SemiBold" Foreground="{StaticResource Text2}"/>
              </Button>
              <Button x:Name="BtnRulesAgree" Style="{StaticResource PrimaryBtn}" Padding="24,11" MinWidth="160">
                <TextBlock Text="I agree" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource OnGold}"/>
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Grid>

    <Canvas x:Name="TrailLayer" Grid.ColumnSpan="2" IsHitTestVisible="False" Panel.ZIndex="300"/>
    <Border x:Name="Lightning" Grid.ColumnSpan="2" Background="#B79B5DE5" Opacity="0" IsHitTestVisible="False" Panel.ZIndex="301"/>
  </Grid>
</Window>
